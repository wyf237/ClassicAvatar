<v:VDialog x:Class="ClassicAvatar.SettingsDialog"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:v="clr-namespace:VControls.Controls;assembly=VControls"
           Title="{DynamicResource C2Loc.Settings.Title}"
           DialogWidth="600"
           ConfirmText="{DynamicResource C2Loc.Settings.Save}"
           CancelText="{DynamicResource C2Loc.Settings.Cancel}"
           ShowCancelButton="True"
           ShowConfirmButton="True"
           CloseOnScrimClick="False"
           CloseOnEscape="True"
           Padding="20"
           CornerRadius="4"
           Background="{DynamicResource VBrush.Surface}"
           BorderBrush="{DynamicResource VBrush.BorderStrong}">

    <StackPanel>
        <!-- WZ data -->
        <Border Style="{StaticResource C2.Card}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{DynamicResource C2Loc.Settings.DataFolder}"
                           Style="{StaticResource C2.Text.Card}" />
                <TextBlock x:Name="DataPathText" FontSize="10.5" Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource VBrush.TextSecondary}" />
                <v:VButton Style="{StaticResource C2.Button.Secondary}" Height="26"
                           HorizontalAlignment="Left" Margin="0,8,0,0"
                           Content="{DynamicResource C2Loc.Settings.Change}"
                           ToolTip="{DynamicResource C2Loc.Settings.DataFolder}"
                           Click="BtnChangeData_Click" />
            </StackPanel>
        </Border>

        <!-- Save folder -->
        <Border Style="{StaticResource C2.Card}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{DynamicResource C2Loc.Settings.SaveFolder}"
                           Style="{StaticResource C2.Text.Card}" />
                <TextBlock x:Name="SavePathText" FontSize="10.5" Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource VBrush.TextSecondary}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <v:VButton Style="{StaticResource C2.Button.Secondary}" Height="26"
                               Content="{DynamicResource C2Loc.Settings.Change}"
                               ToolTip="{DynamicResource C2Loc.Settings.SaveFolder}"
                               Click="BtnChangeSave_Click" />
                    <v:VButton Style="{StaticResource C2.Button.Ghost}" Height="26"
                               Margin="6,0,0,0"
                               Content="{DynamicResource C2Loc.Settings.OpenFolder}"
                               ToolTip="{DynamicResource C2Loc.Settings.OpenFolder}"
                               Click="BtnOpenSave_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Language -->
        <Border Style="{StaticResource C2.Card}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{DynamicResource C2Loc.Settings.Language}"
                           Style="{StaticResource C2.Text.Card}" />
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <RadioButton x:Name="LangZhCN" GroupName="SettingsLanguage"
                                 Style="{StaticResource C2.FilterChip}" Height="26"
                                 Content="简体中文" ToolTip="简体中文" />
                    <RadioButton x:Name="LangZhTW" GroupName="SettingsLanguage"
                                 Style="{StaticResource C2.FilterChip}" Height="26"
                                 Margin="4,0,0,0" Content="繁體中文" ToolTip="繁體中文" />
                    <RadioButton x:Name="LangEnUS" GroupName="SettingsLanguage"
                                 Style="{StaticResource C2.FilterChip}" Height="26"
                                 Margin="4,0,0,0" Content="English" ToolTip="English" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Cache -->
        <Border Style="{StaticResource C2.Card}">
            <StackPanel>
                <TextBlock Text="{DynamicResource C2Loc.Settings.Cache}"
                           Style="{StaticResource C2.Text.Card}" />
                <TextBlock Text="{DynamicResource C2Loc.Settings.CacheDesc}" FontSize="10"
                           TextWrapping="Wrap" Margin="0,4,0,6"
                           Foreground="{DynamicResource VBrush.TextMuted}" />
                <v:VButton Style="{StaticResource C2.Button.Ghost}" Height="26"
                           HorizontalAlignment="Left"
                           Content="{DynamicResource VLoc.Settings.ClearCache}"
                           ToolTip="{DynamicResource C2Loc.Settings.Cache}"
                           Click="BtnClearCache_Click" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" FontSize="10.5" Margin="2,8,0,0"
                   Foreground="{DynamicResource VBrush.Success}" />
    </StackPanel>
</v:VDialog>
