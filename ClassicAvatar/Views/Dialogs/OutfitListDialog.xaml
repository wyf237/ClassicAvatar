<v:VDialog x:Class="ClassicAvatar.OutfitListDialog"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:v="clr-namespace:VControls.Controls;assembly=VControls"
           DialogWidth="560"
           ShowCancelButton="False"
           ShowConfirmButton="False"
           CloseOnScrimClick="True"
           CloseOnEscape="True"
           Padding="16"
           CornerRadius="4"
           Background="{DynamicResource VBrush.Surface}"
           BorderBrush="{DynamicResource VBrush.BorderStrong}">

    <v:VDialog.Resources>
        <DataTemplate x:Key="OutfitDialogRowTemplate">
            <Grid Height="31" ToolTip="{Binding Name}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SlotName}" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource VBrush.TextMuted}" />
                <Border Grid.Column="1" Width="26" Height="26" CornerRadius="3" ClipToBounds="True"
                        Background="{DynamicResource VBrush.Surface2}"
                        VerticalAlignment="Center">
                    <Image Source="{Binding Icon}" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding IdText}" FontFamily="Consolas, Segoe UI"
                           FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource VBrush.TextSecondary}" />
                <TextBlock Grid.Column="3" Text="{Binding Name}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Name}"
                           Foreground="{DynamicResource VBrush.TextPrimary}" />
            </Grid>
        </DataTemplate>
    </v:VDialog.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Copy target: one framed panel holding the slot list and both previews. -->
        <Grid x:Name="ContentRoot" Background="{DynamicResource VBrush.Surface}">
            <Border x:Name="ImageRoot" Background="{DynamicResource VBrush.Surface}"
                    BorderBrush="{DynamicResource VBrush.TextMuted}" BorderThickness="1"
                    CornerRadius="0" Padding="14,12,14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{DynamicResource C2Loc.Outfit.Title}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource VBrush.TextPrimary}" />
                        <TextBlock x:Name="OutfitTitleText" Text="—" FontSize="11" Margin="0,2,0,8"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource VBrush.TextMuted}" />
                        <ItemsControl x:Name="OutfitRows"
                                      ItemTemplate="{StaticResource OutfitDialogRowTemplate}" />
                    </StackPanel>

                    <Grid Grid.Column="1" Width="216" Margin="12,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Current outfit preview, pinned to the panel's top-right corner. -->
                        <Border x:Name="PreviewFrame" VerticalAlignment="Top"
                                Background="{DynamicResource VBrush.Surface2}"
                                BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="1"
                                CornerRadius="{DynamicResource C2.Radius.Card}" Padding="7">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource C2Loc.Outfit.Preview}" FontSize="10"
                                           Foreground="{DynamicResource VBrush.TextSecondary}" />
                                <Border Width="200" Height="140" Margin="0,5,0,0"
                                        Background="{DynamicResource VBrush.Surface}"
                                        CornerRadius="3" ClipToBounds="True">
                                    <Image x:Name="OutfitPreview" Stretch="None"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Large character-only portrait filling the panel down to the list bottom. -->
                        <Border x:Name="PortraitFrame" Grid.Row="1" Margin="0,8,0,0"
                                Background="{DynamicResource VBrush.Surface2}"
                                BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="1"
                                CornerRadius="{DynamicResource C2.Radius.Card}" Padding="7">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource C2Loc.Outfit.Portrait}" FontSize="10"
                                           Foreground="{DynamicResource VBrush.TextSecondary}" />
                                <Border Margin="0,5,0,0" MinHeight="120"
                                        Background="{DynamicResource VBrush.Surface}"
                                        CornerRadius="3" ClipToBounds="True">
                                    <Image x:Name="OutfitPortrait" Stretch="Uniform" Margin="4"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="FeedbackText" FontSize="10.5" Height="14"
                       Foreground="{DynamicResource VBrush.Success}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <v:VButton Style="{StaticResource C2.Button.Secondary}" Height="28" Padding="9,0"
                           FontSize="11.5"
                           Content="{DynamicResource C2Loc.Outfit.CopyText}"
                           ToolTip="{DynamicResource C2Loc.Outfit.CopyText}"
                           Click="BtnCopyText_Click" />
                <v:VButton Style="{StaticResource C2.Button.Primary}" Height="28" Padding="9,0"
                           FontSize="11.5" Margin="6,0,0,0"
                           Content="{DynamicResource C2Loc.Outfit.CopyImage}"
                           ToolTip="{DynamicResource C2Loc.Outfit.CopyImage}"
                           Click="BtnCopyImage_Click" />
                <v:VButton Style="{StaticResource C2.Button.Ghost}" Height="28" Padding="9,0"
                           FontSize="11.5" Margin="6,0,0,0"
                           Content="{DynamicResource C2Loc.Outfit.Close}"
                           ToolTip="{DynamicResource C2Loc.Outfit.Close}"
                           Click="BtnDialogClose_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</v:VDialog>
