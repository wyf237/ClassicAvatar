<Window x:Class="ClassicAvatar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClassicAvatar"
        xmlns:v="clr-namespace:VControls.Controls;assembly=VControls"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        mc:Ignorable="d"
        Title="Classic Avatar"
        Icon="pack://application:,,,/ClassicAvatar;component/Resources/AppIcon.ico"
        Width="1310" Height="830"
        MinWidth="1310" MinHeight="830"
        MaxWidth="1310" MaxHeight="830"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource VFont.Family}"
        FontSize="12.5"
        Foreground="{DynamicResource VBrush.TextPrimary}">

    <Window.Resources>
        <!-- 14 part tiles: outline-free icon + micro label; colour comes from the
             item container so the selected tile turns accent automatically. -->
        <DataTemplate x:Key="PartTileTemplate">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        ToolTip="{Binding Name}">
                <Path Data="{Binding Icon}" Width="17" Height="17" Stretch="Uniform"
                      HorizontalAlignment="Center"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                      SnapsToDevicePixels="True" />
                <TextBlock Text="{Binding Name}" FontSize="10" Margin="0,1,0,0" MaxWidth="36"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Equipment card: 4 per row. -->
        <DataTemplate x:Key="AssetCardTemplate">
            <Grid Margin="2,3" ToolTip="{Binding Name}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Image Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       SnapsToDevicePixels="True" UseLayoutRounding="True"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="10" MaxWidth="64"
                           Margin="0,2,0,0" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                           Foreground="{DynamicResource VBrush.TextPrimary}" />
                <TextBlock Grid.Row="2" Text="{Binding IdText}" FontSize="9.5"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource VBrush.TextMuted}" />
            </Grid>
        </DataTemplate>

        <!-- Outfit library card: 2 per row, full character preview. -->
        <DataTemplate x:Key="LibraryCardTemplate">
            <Grid Width="136" Height="182" Margin="3"
                  Background="Transparent" Cursor="Hand" ToolTip="{Binding Name}"
                  MouseLeftButtonDown="LibraryCard_MouseLeftButtonDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="138" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource VBrush.Surface2}"
                        CornerRadius="3" ClipToBounds="True">
                    <Image Source="{Binding Preview}" Stretch="Uniform" Margin="3"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                           Margin="1,5,1,0" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Name}"
                           Foreground="{DynamicResource VBrush.TextPrimary}" />
                <TextBlock Grid.Row="2" Text="{Binding Meta}" FontSize="9.5" Margin="1,1,1,0"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource VBrush.TextMuted}" />
            </Grid>
        </DataTemplate>

        <!-- One slot line in the current-outfit summary. -->
        <DataTemplate x:Key="OutfitLineTemplate">
            <Grid Height="17" ToolTip="{Binding Value}">
                <TextBlock Text="{Binding Label}" FontSize="10.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource VBrush.TextMuted}" />
                <TextBlock Text="{Binding Value}" FontSize="10.5" MaxWidth="168"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource VBrush.TextSecondary}" />
            </Grid>
        </DataTemplate>


        <DataTemplate x:Key="BgTileTemplate">
            <Border Width="134" Height="84" Margin="3"
                    Background="{DynamicResource VBrush.Surface2}"
                    BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="1"
                    CornerRadius="{DynamicResource C2.Radius.Card}" ClipToBounds="True">
                <StackPanel>
                    <Border Height="58" ClipToBounds="True">
                        <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="10" Margin="0,3,0,0"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource VBrush.TextSecondary}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="WindowBorder"
            Margin="14"
            Background="{DynamicResource VBrush.Window}"
            BorderBrush="{DynamicResource VBrush.Border}"
            BorderThickness="1" CornerRadius="4"
            SnapsToDevicePixels="True"
            SizeChanged="WindowBorder_SizeChanged">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2"
                              Opacity="0.35" Direction="270" />
        </Border.Effect>
        <AdornerDecorator>
        <Grid x:Name="WorkSpace">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="24" />
            </Grid.RowDefinitions>

            <!-- ============================ Header ============================ -->
            <Border Grid.Row="0" x:Name="TitleBar"
                    Background="{DynamicResource VBrush.Surface}"
                    BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="0,0,0,1">
                <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand: geometric mark, no avatar -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                Margin="15,0,0,0" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="2"
                                Background="{DynamicResource VBrush.Accent}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Border.RenderTransform>
                        </Border>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource VLoc.AppName}" FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource VBrush.TextPrimary}" />
                            <TextBlock Text="{DynamicResource C2Loc.Header.Subtitle}" FontSize="10"
                                       FontWeight="SemiBold" Margin="0,1,0,0"
                                       Foreground="{DynamicResource VBrush.TextMuted}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Height="20" Margin="14,0"
                            Background="{DynamicResource VBrush.Border}" />

                    <!-- Project -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="92">
                        <TextBlock Text="{DynamicResource C2Loc.Header.Project}" FontSize="10"
                                   Foreground="{DynamicResource VBrush.TextMuted}" />
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <TextBlock x:Name="DocName" Text="{DynamicResource VLoc.Doc.Untitled}"
                                       FontSize="12" FontWeight="SemiBold" MaxWidth="170"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource VBrush.TextPrimary}" />
                            <Ellipse x:Name="DirtyDot" Width="5" Height="5" Margin="5,0,0,0"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource VBrush.Warning}" Visibility="Collapsed" />
                            <TextBlock x:Name="SaveState" Text="{DynamicResource VLoc.Status.Saved}"
                                       FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource VBrush.TextMuted}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Colorway / help / window buttons -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal"
                                Margin="0,0,10,0" VerticalAlignment="Center">
                        <v:VButton x:Name="BtnSkin" Style="{StaticResource C2.IconButton}"
                                   ToolTip="{DynamicResource C2Loc.Theme.Title}" Click="BtnSkin_Click"
                                   AutomationProperties.Name="{DynamicResource C2Loc.Theme.Title}">
                            <Path Data="{StaticResource C2Icon.Theme}" Width="14" Height="14"
                                  Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=v:VButton}}" />
                        </v:VButton>
                        <v:VButton x:Name="BtnHelp" Style="{StaticResource C2.IconButton}"
                                   ToolTip="{DynamicResource VLoc.Menu.Help}" Click="MenuUsage_Click"
                                   AutomationProperties.Name="{DynamicResource VLoc.Menu.Help}">
                            <Path Data="{StaticResource C2Icon.Help}" Width="13" Height="13"
                                  Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=v:VButton}}" />
                        </v:VButton>

                        <v:VButton x:Name="BtnSettings" Style="{StaticResource C2.IconButton}"
                                   ToolTip="{DynamicResource C2Loc.Settings.Title}" Click="BtnSettings_Click"
                                   AutomationProperties.Name="{DynamicResource C2Loc.Settings.Title}">
                            <Path Data="{StaticResource C2Icon.Settings}" Width="13" Height="13"
                                  Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=v:VButton}}" />
                        </v:VButton>

                        <Border Width="1" Height="18" Margin="7,0"
                                Background="{DynamicResource VBrush.Border}" />

                        <v:VButton x:Name="BtnMin" Style="{StaticResource C2.IconButton}"
                                   ToolTip="{DynamicResource VLoc.Window.Minimize}" Click="BtnMin_Click"
                                   AutomationProperties.Name="{DynamicResource VLoc.Window.Minimize}">
                            <Path Data="{StaticResource C2Icon.Minimize}" Width="12" Height="12"
                                  Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=v:VButton}}" />
                        </v:VButton>
                        <v:VButton x:Name="BtnClose" Style="{StaticResource C2.IconButton.Close}"
                                   ToolTip="{DynamicResource VLoc.Window.Close}" Click="BtnClose_Click"
                                   AutomationProperties.Name="{DynamicResource VLoc.Window.Close}">
                            <Path Data="{StaticResource C2Icon.Close}" Width="11" Height="11"
                                  Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=v:VButton}}" />
                        </v:VButton>
                    </StackPanel>

                    <!-- Colorway picker: Light/Dark bases, then 20 themes -->
                    <Popup x:Name="SkinPopup" PlacementTarget="{Binding ElementName=BtnSkin}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           PopupAnimation="Fade" VerticalOffset="6" HorizontalOffset="-412">
                        <Border Width="470" Background="{DynamicResource VBrush.Surface}"
                                BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="1"
                                CornerRadius="5" Margin="10" Padding="10"
                                Effect="{DynamicResource VShadow.Popup}">
                            <StackPanel>
                                <Grid Margin="4,2,4,6">
                                    <TextBlock Text="{DynamicResource C2Loc.Theme.Title}"
                                               Style="{StaticResource C2.Text.Card}" />
                                    <TextBlock Text="{DynamicResource VLoc.AppVersion}"
                                               HorizontalAlignment="Right" Style="{StaticResource C2.Text.Caption}" />
                                </Grid>

                                <UniformGrid x:Name="BasePaletteGrid" Columns="2" />

                                <Border Style="{StaticResource C2.Hairline}" Margin="4,8,4,8" />

                                <ScrollViewer MaxHeight="410" VerticalScrollBarVisibility="Auto">
                                    <WrapPanel x:Name="PaletteGrid" ItemWidth="219" />
                                </ScrollViewer>

                                <TextBlock Text="{DynamicResource C2Loc.Theme.Persist}"
                                           Style="{StaticResource C2.Text.Micro}" Margin="4,7,4,2" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- ============================= Body ============================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BrowserColumn" Width="320" />
                    <ColumnDefinition x:Name="RevealColumn" Width="0" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- ========================= Left browser ========================= -->
                <Border x:Name="BrowserPanel" Grid.Column="0"
                        Background="{DynamicResource VBrush.Surface}"
                        BorderBrush="{DynamicResource VBrush.Border}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48" />
                            <RowDefinition Height="31" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Browser header -->
                        <Grid Grid.Row="0" Margin="12,0,8,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource C2Loc.Browser.Title}"
                                           Style="{StaticResource C2.Text.Section}" FontSize="16" />
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock x:Name="EquipSlotName"
                                               Text="上衣"
                                               FontSize="10"
                                               Foreground="{DynamicResource VBrush.TextMuted}" />
                                    <TextBlock Text=" · " FontSize="10"
                                               Foreground="{DynamicResource VBrush.TextMuted}" />
                                    <TextBlock x:Name="EquipCount" Text=""
                                               FontSize="10"
                                               Foreground="{DynamicResource VBrush.TextMuted}" />
                                </StackPanel>
                            </StackPanel>
                            <v:VButton x:Name="BtnCollapseBrowser" Style="{StaticResource C2.IconButton}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       ToolTip="{DynamicResource VLoc.Equip.Close}"
                                       AutomationProperties.Name="{DynamicResource VLoc.Equip.Close}"
                                       Click="BtnCollapseBrowser_Click">
                                <Path Data="{StaticResource C2Icon.Close}" Width="10" Height="10"
                                      Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=v:VButton}}" />
                            </v:VButton>
                        </Grid>

                        <!-- Browser tabs -->
                        <Border Grid.Row="1" BorderBrush="{DynamicResource VBrush.Border}"
                                BorderThickness="0,0,0,1">
                            <UniformGrid Columns="3" Margin="10,0">
                                <RadioButton x:Name="EquipmentTab" GroupName="BrowserTab" IsChecked="True"
                                             Style="{StaticResource C2.Tab}"
                                             Content="{DynamicResource VLoc.Rail.Equipment}"
                                             ToolTip="{DynamicResource VLoc.Rail.Equipment}"
                                             Checked="BrowserTab_Checked" />
                                <RadioButton x:Name="OutfitsTab" GroupName="BrowserTab"
                                             Style="{StaticResource C2.Tab}"
                                             Content="{DynamicResource C2Loc.Browser.Outfits}"
                                             ToolTip="{DynamicResource C2Loc.Browser.Outfits}"
                                             Checked="BrowserTab_Checked" />
                                <RadioButton x:Name="BackgroundsTab" GroupName="BrowserTab"
                                             Style="{StaticResource C2.Tab}"
                                             Content="{DynamicResource VLoc.Background.Title}"
                                             ToolTip="{DynamicResource VLoc.Background.Title}"
                                             Checked="BrowserTab_Checked" />
                            </UniformGrid>
                        </Border>

                        <Grid Grid.Row="2">
                            <!-- Equipment pane -->
                            <Grid x:Name="EquipmentPane">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="12,7,12,0" Height="18">
                                    <TextBlock Text="{DynamicResource C2Loc.Part.Title}"
                                               FontSize="10.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource VBrush.TextSecondary}" />
                                    <TextBlock x:Name="CurrentPartText"
                                               Text="{DynamicResource C2Loc.Part.Current}" FontSize="10"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource VBrush.TextMuted}" />
                                </Grid>

                                <ListBox x:Name="ListSlots" Grid.Row="1" Margin="10,3,10,0"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         SelectionChanged="ListSlots_SelectionChanged">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7" Rows="2" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource C2.PartTile}">
                                            <Setter Property="Margin" Value="1.25,1.5" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <StaticResource ResourceKey="PartTileTemplate" />
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid Grid.Row="2" Margin="11,7,11,0" Height="28">
                                    <TextBox x:Name="EquipSearch" Style="{StaticResource VSearchBox}"
                                             Height="28" FontSize="11.5"
                                             TextChanged="EquipSearch_TextChanged"
                                             ToolTip="{DynamicResource VLoc.Equip.SearchPlaceholder}" />
                                    <TextBlock Text="{DynamicResource C2Loc.Search.Placeholder}"
                                               FontSize="10.5" Margin="31,0,8,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Foreground="{DynamicResource VBrush.TextMuted}">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=EquipSearch}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Grid Grid.Row="3" Margin="11,4,11,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="FilterAll" GroupName="EquipFilter" IsChecked="True"
                                                     Style="{StaticResource C2.FilterChip}"
                                                     Content="{DynamicResource VLoc.Equip.Filter.All}"
                                                     ToolTip="{DynamicResource VLoc.Equip.Filter.All}"
                                                     Checked="EquipFilter_Changed" />
                                        <RadioButton x:Name="FilterFavorites" GroupName="EquipFilter"
                                                     Style="{StaticResource C2.FilterChip}" Margin="2,0,0,0"
                                                     Content="{DynamicResource VLoc.Equip.Filter.Favorites}"
                                                     ToolTip="{DynamicResource VLoc.Equip.Filter.Favorites}"
                                                     Checked="EquipFilter_Changed" />
                                        <RadioButton x:Name="FilterRecent" GroupName="EquipFilter"
                                                     Style="{StaticResource C2.FilterChip}" Margin="2,0,0,0"
                                                     Content="{DynamicResource VLoc.Equip.Filter.Recent}"
                                                     ToolTip="{DynamicResource VLoc.Equip.Filter.Recent}"
                                                     Checked="EquipFilter_Changed" />
                                    </StackPanel>
                                    <ComboBox x:Name="EquipCashFilter" Style="{StaticResource VComboBox}"
                                              Width="78" Height="22" FontSize="10.5"
                                              HorizontalAlignment="Right" SelectedIndex="0"
                                              SelectionChanged="EquipFilter_Changed"
                                              ToolTip="{DynamicResource VLoc.Equip.CashFilter}">
                                        <ComboBoxItem Content="{DynamicResource VLoc.Equip.Filter.All}" />
                                        <ComboBoxItem Content="{DynamicResource VLoc.Equip.Normal}" />
                                        <ComboBoxItem Content="{DynamicResource VLoc.Equip.Cash}" />
                                    </ComboBox>
                                </Grid>

                                <Border Grid.Row="4" Height="43" Margin="11,6,11,0" Padding="6,0"
                                        Background="{DynamicResource VBrush.Surface2}"
                                        BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="1"
                                        CornerRadius="{DynamicResource C2.Radius.Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="3" ClipToBounds="True"
                                                Background="{DynamicResource VBrush.Surface3}"
                                                VerticalAlignment="Center">
                                            <Image x:Name="EquipSelectedThumb" Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="EquipSelectedName"
                                                       Text="{DynamicResource VLoc.Equip.NoSelection}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource VBrush.TextPrimary}" />
                                            <TextBlock x:Name="EquipSelectedId" Text="—" FontSize="10"
                                                       Foreground="{DynamicResource VBrush.TextMuted}" />
                                        </StackPanel>
                                        <v:VButton Grid.Column="2" Width="22" Height="22" Padding="0"
                                                   Variant="Ghost" VerticalAlignment="Center"
                                                   Click="BtnEquipRemove_Click"
                                                   ToolTip="{DynamicResource VLoc.Equip.Remove}">
                                            <Path Data="{StaticResource C2Icon.Delete}" Width="11" Height="11"
                                                  Stretch="Uniform"
                                                  Fill="{DynamicResource VBrush.TextMuted}" />
                                        </v:VButton>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="5" Margin="0,0,0,0">
                                    <ListBox x:Name="ListEquip" Margin="9,2,9,0"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             VerticalContentAlignment="Top"
                                             SelectionChanged="ListEquip_SelectionChanged"
                                             PreviewMouseRightButtonDown="ListEquip_PreviewMouseRightButtonDown">
                                        <ListBox.ContextMenu>
                                            <ContextMenu Style="{StaticResource VContextMenu}"
                                                         Opened="ListEquipContextMenu_Opened"
                                                         Closed="ListEquipContextMenu_Closed">
                                                <MenuItem Header="{DynamicResource VLoc.Equip.CopyId}" Style="{StaticResource VMenuItem.Sub}" Click="MenuCopyId_Click" />
                                                <MenuItem Header="{DynamicResource VLoc.Equip.CopyName}" Style="{StaticResource VMenuItem.Sub}" Click="MenuCopyName_Click" />
                                                <Separator />
                                                <MenuItem x:Name="MenuFavorite" Header="{DynamicResource VLoc.Equip.Favorite}" Style="{StaticResource VMenuItem.Sub}" Click="MenuFavorite_Click" />
                                                <MenuItem x:Name="MenuUnfavorite" Header="{DynamicResource C2Loc.Equip.Unfavorite}" Style="{StaticResource VMenuItem.Sub}" Click="MenuUnfavorite_Click" />
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <vwp:VirtualizingWrapPanel Orientation="Horizontal"
                                                                           SpacingMode="None"
                                                                           StretchItems="False" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource C2.AssetCard}" />
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <StaticResource ResourceKey="AssetCardTemplate" />
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Grid x:Name="EquipLoading" Visibility="Collapsed"
                                          Background="{DynamicResource VBrush.Surface}" Opacity="0.94">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource VLoc.Common.Loading}" FontSize="11.5"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource VBrush.Accent}" />
                                            <Border Width="64" Height="2" Margin="0,7,0,0" CornerRadius="1"
                                                    Background="{DynamicResource VBrush.Accent}">
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="Border.Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="0.25" To="1" Duration="0:0:0.7"
                                                                                 AutoReverse="True" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!-- Outfits pane -->
                            <Grid x:Name="OutfitsPane" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="11,7,11,0" Height="28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LibrarySearch" Style="{StaticResource VSearchBox}"
                                             Height="28" FontSize="11.5"
                                             TextChanged="LibrarySearch_TextChanged"
                                             ToolTip="{DynamicResource VLoc.Equip.SearchPlaceholder}" />
                                    <TextBlock Text="{DynamicResource C2Loc.Search.Placeholder}"
                                               FontSize="10.5" Margin="31,0,8,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Foreground="{DynamicResource VBrush.TextMuted}">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=LibrarySearch}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <v:VButton Grid.Column="1" Style="{StaticResource C2.Button.Primary}"
                                               Height="28" Margin="6,0,0,0"
                                               Content="{DynamicResource VLoc.Library.New}"
                                               ToolTip="{DynamicResource VLoc.Library.New}"
                                               Click="BtnLibraryNew_Click" />
                                </Grid>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="11,4,11,0">
                                    <RadioButton x:Name="LibFilterAll" GroupName="LibFilter" IsChecked="True"
                                                 Style="{StaticResource C2.FilterChip}"
                                                 Content="{DynamicResource VLoc.Equip.Filter.All}"
                                                 ToolTip="{DynamicResource VLoc.Equip.Filter.All}"
                                                 Checked="LibFilter_Changed" />
                                    <RadioButton x:Name="LibFilterRecent" GroupName="LibFilter"
                                                 Style="{StaticResource C2.FilterChip}" Margin="2,0,0,0"
                                                 Content="{DynamicResource VLoc.Equip.Filter.Recent}"
                                                 ToolTip="{DynamicResource VLoc.Equip.Filter.Recent}"
                                                 Checked="LibFilter_Changed" />
                                    <v:VButton Style="{StaticResource C2.Button.Ghost}" Height="22" Padding="7,0"
                                               Margin="4,0,0,0" FontSize="10.5"
                                               Content="{DynamicResource VLoc.Library.Import}"
                                               ToolTip="{DynamicResource VLoc.Library.Import}"
                                               Click="BtnLibraryImport_Click" />
                                </StackPanel>

                                <Grid Grid.Row="2" Margin="9,4,9,0">
                                    <ListBox x:Name="LibraryList" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource C2.LibraryCard}" />
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <StaticResource ResourceKey="LibraryCardTemplate" />
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel x:Name="LibraryEmpty" Visibility="Collapsed"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Margin="18,0">
                                        <Border Width="44" Height="44" CornerRadius="4"
                                                Background="{DynamicResource VBrush.AccentSoft}"
                                                HorizontalAlignment="Center">
                                            <Path Data="{StaticResource VIcon.Library}" Width="20" Height="20"
                                                  Stretch="Uniform" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Fill="{DynamicResource VBrush.Accent}" />
                                        </Border>
                                        <TextBlock Text="{DynamicResource VLoc.Library.EmptyTitle}"
                                                   FontSize="13.5" FontWeight="SemiBold" Margin="0,10,0,0"
                                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource VBrush.TextPrimary}" />
                                        <TextBlock Text="{DynamicResource VLoc.Library.EmptyBody}"
                                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   Foreground="{DynamicResource VBrush.TextMuted}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="3" Margin="12,0,12,0">
                                    <TextBlock x:Name="LibraryCount" Text="" FontSize="10"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource VBrush.TextMuted}" />
                                    <TextBlock Text="{DynamicResource VLoc.Library.LocalNote}" FontSize="10"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource VBrush.TextMuted}" />
                                </Grid>
                            </Grid>

                            <!-- Backgrounds pane -->
                            <Grid x:Name="BackgroundsPane" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="12,9,12,0">
                                    <TextBlock Text="{DynamicResource VLoc.Background.Title}"
                                               Style="{StaticResource C2.Text.Card}" />
                                    <TextBlock Text="{DynamicResource C2Loc.Background.Hint}" FontSize="10"
                                               Margin="0,2,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource VBrush.TextMuted}" />
                                </StackPanel>

                                <ListBox x:Name="BgInlineList" Grid.Row="1" Margin="7,4,7,0"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         SelectionChanged="BgInlineList_SelectionChanged">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListBoxItem}">
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                        <Border x:Name="Bd" Background="Transparent"
                                                                BorderBrush="Transparent" BorderThickness="2"
                                                                CornerRadius="5" Padding="0">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource VBrush.BorderStrong}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource VBrush.Accent}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <StaticResource ResourceKey="BgTileTemplate" />
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="11,6,11,8">
                                    <v:VButton Style="{StaticResource C2.Button.Secondary}" Height="24"
                                               Content="{DynamicResource C2Loc.Background.None}"
                                               Click="BtnBgNone_Click" />
                                    <v:VButton Style="{StaticResource C2.Button.Ghost}" Height="24" Margin="4,0,0,0"
                                               Content="{DynamicResource VLoc.Background.OpenFolder}"
                                               Click="BtnBgFolder_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ========================= Preview ========================= -->
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="PreviewCompareColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="31" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="43" />
                    </Grid.RowDefinitions>

                    <!-- Document tabs (VControls VTabControl) -->
                    <Grid Grid.Row="0" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <v:VTabControl x:Name="MainTabs" Grid.Column="0"
                                       Style="{StaticResource C2.VTabControl}"
                                       Margin="10,0,4,0"
                                       SelectionChanged="MainTabs_SelectionChanged"
                                       TabCloseRequested="Tabs_TabCloseRequested" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    Margin="0,0,12,0" VerticalAlignment="Center">
                            <v:VButton x:Name="BtnCompare" Style="{StaticResource C2.Button.Ghost}"
                                       Height="26" Padding="7,0"
                                       Content="{DynamicResource C2Loc.Compare}"
                                       ToolTip="{DynamicResource C2Loc.Compare}"
                                       Click="BtnCompare_Click" />
                            <v:VButton x:Name="BtnRecent" Style="{StaticResource C2.Button.Ghost}"
                                       Height="26" Padding="7,0" Margin="2,0,0,0"
                                       Content="{DynamicResource VLoc.Menu.Recent}"
                                       ToolTip="{DynamicResource VLoc.Menu.Recent}"
                                       Click="BtnRecent_Click" />
                        </StackPanel>
                    </Grid>

                    <v:VTabControl x:Name="CompareTabs" Grid.Row="0" Grid.Column="1"
                                   Style="{StaticResource C2.VTabControl}"
                                   Margin="2,0,12,0" Visibility="Collapsed"
                                   ShowAddButton="False"
                                   SelectionChanged="CompareTabs_SelectionChanged"
                                   TabCloseRequested="Tabs_TabCloseRequested" />

                    <!-- Stage head -->
                    <Grid Grid.Row="1" Grid.Column="0" Margin="12,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="StageDocName" Text="—"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource VBrush.TextPrimary}" />
                            <TextBlock Text=" / " FontSize="12"
                                       Foreground="{DynamicResource VBrush.TextMuted}" />
                            <TextBlock Text="{DynamicResource C2Loc.Stage.Title}" FontSize="12"
                                       Foreground="{DynamicResource VBrush.TextMuted}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <v:VButton x:Name="BtnBackGround" Style="{StaticResource C2.Button.Secondary}"
                                       Height="24" Padding="6,0" Click="BtnBackGround_Click"
                                       ToolTip="{DynamicResource VLoc.Stage.Background}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="14" Height="14" CornerRadius="2" ClipToBounds="True"
                                            Background="{DynamicResource VBrush.Surface3}">
                                        <Image x:Name="BgChipThumb" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock x:Name="BgChipName" Text="{DynamicResource VLoc.Stage.NoBackground}"
                                               FontSize="10.5" Margin="5,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource VBrush.TextSecondary}" />
                                    <Path Data="{StaticResource VIcon.ChevronDown}" Width="7" Height="7"
                                          Stretch="Uniform" Margin="4,1,0,0" VerticalAlignment="Center"
                                          Fill="{DynamicResource VBrush.TextMuted}" />
                                </StackPanel>
                            </v:VButton>
                            <TextBlock x:Name="CanvasInfo" Text="560 × 480 · 3×" FontSize="10"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource VBrush.TextMuted}" />
                        </StackPanel>

                        <Popup x:Name="BgPopup" PlacementTarget="{Binding ElementName=BtnBackGround}"
                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               PopupAnimation="Fade" HorizontalOffset="-130" VerticalOffset="6">
                            <Border Width="312" Background="{DynamicResource VBrush.Surface}"
                                    BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="1"
                                    CornerRadius="5" Margin="10" Padding="10"
                                    Effect="{DynamicResource VShadow.Popup}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="{DynamicResource VLoc.Background.Title}"
                                                   Style="{StaticResource C2.Text.Card}" />
                                        <v:VButton Width="22" Height="22" Padding="0" Variant="Ghost"
                                                   HorizontalAlignment="Right" Click="BtnBgPopupClose_Click"
                                                   ToolTip="{DynamicResource VLoc.Window.Close}">
                                            <Path Data="{StaticResource VIcon.Close}" Width="9" Height="9"
                                                  Stretch="Uniform"
                                                  Fill="{DynamicResource VBrush.TextMuted}" />
                                        </v:VButton>
                                    </Grid>
                                    <ListBox x:Name="BgList" Background="Transparent" BorderThickness="0"
                                             Height="172" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             SelectionChanged="BgList_SelectionChanged">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="{x:Type ListBoxItem}">
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                            <Border x:Name="Bd" Margin="2" Background="{DynamicResource VBrush.Surface2}"
                                                                    BorderBrush="{DynamicResource VBrush.Border}"
                                                                    BorderThickness="1" CornerRadius="3">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource VBrush.BorderStrong}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource VBrush.Accent}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4">
                                                    <Border Height="52" CornerRadius="2" ClipToBounds="True">
                                                        <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="10" Margin="0,3,0,0"
                                                               HorizontalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource VBrush.TextSecondary}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Margin="0,8,0,0">
                                        <v:VButton Content="{DynamicResource VLoc.Stage.NoBackground}"
                                                   Style="{StaticResource C2.Button.Secondary}" Height="24"
                                                   HorizontalAlignment="Left" Click="BtnBgNone_Click" />
                                        <v:VButton Content="{DynamicResource VLoc.Background.OpenFolder}"
                                                   Style="{StaticResource C2.Button.Ghost}" Height="24"
                                                   HorizontalAlignment="Right" Click="BtnBgFolder_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Scene -->
                    <Border x:Name="SceneBorder" Grid.Row="2" Grid.Column="0" Margin="12,0,12,8"
                            Background="{DynamicResource VBrush.Stage}"
                            BorderBrush="{DynamicResource VBrush.Border}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource C2.Radius.Card}"
                            ClipToBounds="True"
                            Tag="Left"
                            MouseLeftButtonDown="PreviewPane_MouseLeftButtonDown">
                        <Grid x:Name="SceneRoot" ClipToBounds="True">
                            <Image x:Name="BackgroundImage" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border Background="{DynamicResource VBrush.PreviewWash}"
                                    IsHitTestVisible="False" />

                            <Canvas x:Name="PreviewHost" ClipToBounds="True" IsHitTestVisible="False"
                                    SizeChanged="OnPreviewHostSizeChanged">
                                <Image x:Name="Preview" Stretch="None"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Canvas>

                            <!-- Scene title -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="10,10,0,0" Padding="6,3"
                                    Background="{DynamicResource VBrush.SceneTitleSurface}"
                                    BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="1"
                                    CornerRadius="3" IsHitTestVisible="False">
                                <StackPanel>
                                    <TextBlock x:Name="SceneTitleLine" Text="SPRING RANGER" FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource VBrush.TextSecondary}" />
                                    <TextBlock x:Name="SceneActionLine" Text="stand1" FontSize="10"
                                               Foreground="{DynamicResource VBrush.TextMuted}" />
                                </StackPanel>
                            </Border>

                            <!-- 1:1 reference card -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,10,10,0" Width="144"
                                    Background="{DynamicResource VBrush.MiniSurface}"
                                    BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="1"
                                    CornerRadius="{DynamicResource C2.Radius.Card}"
                                    Effect="{DynamicResource C2.Shadow.Mini}"
                                    IsHitTestVisible="False">
                                <StackPanel Margin="8,7,8,7">
                                    <TextBlock x:Name="MiniEquipCountText" Text="" FontSize="10"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource VBrush.TextSecondary}" />
                                    <Border Height="96" Margin="0,6,0,0" CornerRadius="3" ClipToBounds="True"
                                            Background="{DynamicResource VBrush.Surface2}">
                                        <Image x:Name="MiniPreview" Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Loading -->
                            <Grid x:Name="Loading" Visibility="Collapsed"
                                  Background="{DynamicResource VBrush.Scrim}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource VLoc.Common.Loading}" FontSize="12.5"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource VBrush.TextPrimary}" />
                                    <Border Width="80" Height="2" Margin="0,8,0,0" CornerRadius="1"
                                            Background="{DynamicResource VBrush.Accent}">
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="Border.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.3" To="1" Duration="0:0:0.7"
                                                                         AutoReverse="True" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- No data -->
                            <Grid x:Name="NoDataPanel" Background="{DynamicResource VBrush.Stage}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                                    <Border Width="46" Height="46" CornerRadius="4"
                                            Background="{DynamicResource VBrush.AccentSoft}"
                                            HorizontalAlignment="Center">
                                        <Path Data="{StaticResource VIcon.Folder}" Width="22" Height="22"
                                              Stretch="Uniform" HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Fill="{DynamicResource VBrush.Accent}" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource VLoc.NoData.Title}" FontSize="17"
                                               FontWeight="SemiBold" Margin="0,12,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource VBrush.TextPrimary}" />
                                    <TextBlock Text="{DynamicResource VLoc.NoData.Desc}" FontSize="11.5"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                                               Foreground="{DynamicResource VBrush.TextSecondary}" />
                                    <v:VButton Content="{DynamicResource VLoc.NoData.Button}"
                                               Style="{StaticResource C2.Button.Primary}" Height="28"
                                               Padding="14,0" Margin="0,14,0,0"
                                               HorizontalAlignment="Center" Click="MenuItem_Open_Click" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Compare stage head -->
                    <Grid x:Name="CompareHead" Grid.Row="1" Grid.Column="1"
                          Margin="8,0,12,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="CompareDocName" Text="—" FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource VBrush.TextPrimary}" />
                            <TextBlock Text=" / " FontSize="12"
                                       Foreground="{DynamicResource VBrush.TextMuted}" />
                            <TextBlock Text="{DynamicResource C2Loc.Compare.Title}" FontSize="12"
                                       Foreground="{DynamicResource VBrush.TextMuted}" />
                        </StackPanel>
                        <TextBlock x:Name="CompareCanvasInfo" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontSize="10.5"
                                   Foreground="{DynamicResource VBrush.TextMuted}" />
                    </Grid>

                    <!-- Compare scene -->
                    <Border x:Name="CompareScene" Grid.Row="2" Grid.Column="1"
                            Margin="6,0,12,8" Background="{DynamicResource VBrush.Stage}"
                            BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource C2.Radius.Card}"
                            ClipToBounds="True" Visibility="Collapsed"
                            Tag="Right"
                            MouseLeftButtonDown="PreviewPane_MouseLeftButtonDown">
                        <Grid ClipToBounds="True">
                            <Image x:Name="CompareBackgroundImage" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Border Background="{DynamicResource VBrush.PreviewWash}"
                                    IsHitTestVisible="False" />
                            <Canvas x:Name="ComparePreviewHost" ClipToBounds="True"
                                    IsHitTestVisible="False"
                                    SizeChanged="OnCompareHostSizeChanged">
                                <Image x:Name="ComparePreview" Stretch="None"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Canvas>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="10,10,0,0" Padding="6,3"
                                    Background="{DynamicResource VBrush.SceneTitleSurface}"
                                    BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="1"
                                    CornerRadius="3" IsHitTestVisible="False">
                                <StackPanel>
                                    <TextBlock x:Name="CompareSceneTitle" Text="—" FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource VBrush.TextSecondary}" />
                                    <TextBlock x:Name="CompareSceneAction" Text="—" FontSize="10"
                                               Foreground="{DynamicResource VBrush.TextMuted}" />
                                </StackPanel>
                            </Border>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,10,10,0" Width="144"
                                    Background="{DynamicResource VBrush.MiniSurface}"
                                    BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="1"
                                    CornerRadius="{DynamicResource C2.Radius.Card}"
                                    IsHitTestVisible="False">
                                <StackPanel Margin="8,7,8,7">
                                    <TextBlock x:Name="CompareMiniEquipCountText" Text="" FontSize="10"
                                               Foreground="{DynamicResource VBrush.TextSecondary}" />
                                    <Border Height="96" Margin="0,6,0,0" CornerRadius="3" ClipToBounds="True"
                                            Background="{DynamicResource VBrush.Surface2}">
                                        <Image x:Name="CompareMini" Stretch="Uniform"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Transport -->
                    <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{DynamicResource VBrush.Surface}"
                            BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="0,1,0,0"
                            Padding="10,0">
                        <Grid Height="43" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <v:VButton x:Name="BtnPlay" Width="30" Height="30" Padding="0"
                                       MinWidth="0" MinHeight="0"
                                       Variant="Primary" CornerRadius="15"
                                       Click="BtnPlay_Click" ToolTip="{DynamicResource VLoc.Stage.Play}"
                                       AutomationProperties.Name="{DynamicResource VLoc.Stage.Play}">
                                <Path x:Name="PlayIcon" Data="{StaticResource C2Icon.Play}"
                                      Width="10" Height="10" Stretch="Uniform"
                                      Fill="{DynamicResource VBrush.OnAccent}" />
                            </v:VButton>

                            <ComboBox x:Name="ActionBox" Grid.Column="1" Style="{StaticResource VComboBox}"
                                      Width="118" Height="24" Margin="8,0,0,0" FontSize="11"
                                      SelectionChanged="OnActionChanged"
                                      ToolTip="{DynamicResource VLoc.Stage.Action}" />

                            <TextBlock x:Name="FpsText" Grid.Column="2" Text="24 FPS" FontSize="10" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource VBrush.TextMuted}" />

                            <Grid Grid.Column="3" Margin="8,0,10,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="FrameProgress" Style="{StaticResource C2.Progress}"
                                             Minimum="0" Maximum="1" Value="0"
                                             VerticalAlignment="Center" />
                                <TextBlock x:Name="FrameTimeText" Grid.Column="1" Text="00:00 / 00:00"
                                           FontFamily="Consolas, Segoe UI" FontSize="10" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource VBrush.TextMuted}" />
                            </Grid>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <v:VButton x:Name="BtnUndo" Style="{StaticResource C2.IconButton}"
                                           ToolTip="{DynamicResource VLoc.Menu.Undo}" Click="MenuUndo_Click"
                                           AutomationProperties.Name="{DynamicResource VLoc.Menu.Undo}">
                                    <Path Data="{StaticResource VIcon.Undo}" Width="13" Height="13"
                                          Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=v:VButton}}" />
                                </v:VButton>
                                <v:VButton x:Name="BtnRedo" Style="{StaticResource C2.IconButton}"
                                           ToolTip="{DynamicResource VLoc.Menu.Redo}" Click="MenuRedo_Click"
                                           AutomationProperties.Name="{DynamicResource VLoc.Menu.Redo}"
                                           Margin="2,0,0,0">
                                    <Path Data="{StaticResource VIcon.Redo}" Width="13" Height="13"
                                          Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=v:VButton}}" />
                                </v:VButton>
                            </StackPanel>

                            <v:VButton x:Name="BtnLucky" Grid.Column="5" Style="{StaticResource C2.Button.Ghost}"
                                       Height="25" Padding="9,0" Margin="8,0,0,0"
                                       Content="{DynamicResource C2Loc.Transport.Lucky}"
                                       Click="BtnRandomAppearance_Click"
                                       ToolTip="{DynamicResource VLoc.Inspector.Random}" />

                            <v:VButton x:Name="BtnSave" Grid.Column="6" Style="{StaticResource C2.Button.Secondary}"
                                       Height="25" Margin="6,0,0,0"
                                       Content="{DynamicResource C2Loc.Transport.Save}"
                                       Click="MenuSave_Click"
                                       ToolTip="{DynamicResource VLoc.Menu.Save}"
                                       AutomationProperties.Name="{DynamicResource VLoc.Menu.Save}" />

                            <v:VButton x:Name="BtnSaveAs" Grid.Column="7" Style="{StaticResource C2.Button.Secondary}"
                                       Height="25" Margin="6,0,0,0"
                                       Content="{DynamicResource C2Loc.Transport.SaveAs}"
                                       Click="MenuSaveAs_Click"
                                       ToolTip="{DynamicResource VLoc.Menu.SaveAs}"
                                       AutomationProperties.Name="{DynamicResource VLoc.Menu.SaveAs}" />

                            <v:VButton x:Name="BtnExport" Grid.Column="8" Style="{StaticResource C2.Button.Primary}"
                                       Height="25" Margin="6,0,0,0"
                                       Content="{DynamicResource C2Loc.Transport.Export}"
                                       Click="BtnExport_Click"
                                       ToolTip="{DynamicResource VLoc.Menu.Export}"
                                       AutomationProperties.Name="{DynamicResource VLoc.Menu.Export}">
                                <v:VButton.ContextMenu>
                                    <ContextMenu Style="{StaticResource VContextMenu}" Placement="Top">
                                        <MenuItem Header="{DynamicResource VLoc.Menu.ExportPng}" Style="{StaticResource VMenuItem.Sub}" Click="MenuExportPng_Click" />
                                        <MenuItem Header="{DynamicResource VLoc.Menu.ExportGif}" Style="{StaticResource VMenuItem.Sub}" Click="MenuExportGif_Click" />
                                        <MenuItem Header="{DynamicResource VLoc.Menu.ExportText}" Style="{StaticResource VMenuItem.Sub}" Click="MenuExportText_Click" />
                                        <Separator />
                                        <MenuItem Header="{DynamicResource VLoc.Menu.ExportAvatar}" Style="{StaticResource VMenuItem.Sub}" Click="MenuExportAvatar_Click" />
                                    </ContextMenu>
                                </v:VButton.ContextMenu>
                            </v:VButton>
                        </Grid>
                    </Border>

                </Grid>

                <!-- ======================= Right inspector ======================= -->
                <Border Grid.Column="3" Background="{DynamicResource VBrush.Surface}"
                        BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="52" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="22" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="12,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource C2Loc.Inspector.Title}" FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource VBrush.TextPrimary}" />
                                <TextBlock Text="{DynamicResource C2Loc.Inspector.Subtitle}" FontSize="10"
                                           Margin="0,1,0,0"
                                           Foreground="{DynamicResource VBrush.TextMuted}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <v:VButton x:Name="BtnReset" Style="{StaticResource C2.Button.Ghost}"
                                           Height="22" Padding="6,0" FontSize="10.5" Margin="2,0,0,0"
                                           Content="{DynamicResource VLoc.Inspector.Reset}"
                                           Click="BtnReset_Click"
                                           ToolTip="{DynamicResource VLoc.Inspector.Reset}" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Padding="12,0,12,6">
                            <StackPanel>
                                <!-- Gender -->
                                <Border Style="{StaticResource C2.Card}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource VLoc.Inspector.Gender}"
                                                   Style="{StaticResource C2.Text.Card}" />
                                        <Border Background="{DynamicResource VBrush.Surface2}"
                                                CornerRadius="{DynamicResource C2.Radius.Control}"
                                                Padding="2" Margin="0,7,0,0">
                                            <UniformGrid Columns="2">
                                                <RadioButton x:Name="Male" GroupName="Gender" Tag="Male"
                                                             IsChecked="True" Style="{StaticResource C2.Segment}"
                                                             Content="{DynamicResource VLoc.Inspector.Male}"
                                                             ToolTip="{DynamicResource VLoc.Inspector.Male}"
                                                             Checked="Gender_Checked"
                                                             PreviewMouseLeftButtonDown="ChooseSex" />
                                                <RadioButton x:Name="Female" GroupName="Gender" Tag="Female"
                                                             Style="{StaticResource C2.Segment}"
                                                             Content="{DynamicResource VLoc.Inspector.Female}"
                                                             ToolTip="{DynamicResource VLoc.Inspector.Female}"
                                                             Checked="Gender_Checked"
                                                             PreviewMouseLeftButtonDown="ChooseSex" />
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Skin -->
                                <Border Style="{StaticResource C2.Card}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{DynamicResource VLoc.Inspector.Skin}"
                                                       Style="{StaticResource C2.Text.Card}" />
                                            <TextBlock x:Name="SkinName" Text="暖白 02" FontSize="10"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource VBrush.TextMuted}" />
                                        </Grid>
                                        <ListBox x:Name="ListSkin" Background="Transparent" BorderThickness="0"
                                                 Margin="0,4,0,0" SelectionChanged="ListSkin_SelectionChanged">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource C2.Swatch}" />
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="20" Height="20" CornerRadius="10"
                                                            Background="{Binding Color}"
                                                            ToolTip="{Binding Name}" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>

                                <!-- Hair -->
                                <Border Style="{StaticResource C2.Card}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{DynamicResource VLoc.Inspector.Hair}"
                                                       Style="{StaticResource C2.Text.Card}" />
                                            <TextBlock x:Name="HairIdText" Text="#30000" FontSize="10"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource VBrush.TextMuted}" />
                                        </Grid>
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="31" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="31" Height="31" CornerRadius="3" ClipToBounds="True"
                                                    Background="{DynamicResource VBrush.Surface2}">
                                                <Image x:Name="HairThumb" Stretch="Uniform" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="HairName" Text="—" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource VBrush.TextPrimary}" />
                                                <Border x:Name="HairChip" Visibility="Collapsed"
                                                        Background="{DynamicResource VBrush.AccentSoft}"
                                                        CornerRadius="2" Padding="3,0"
                                                        HorizontalAlignment="Left" Margin="0,2,0,0">
                                                    <TextBlock Text="{DynamicResource VLoc.Equip.Equipped}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource VBrush.Accent}" />
                                                </Border>
                                            </StackPanel>
                                            <v:VButton Grid.Column="2" Style="{StaticResource C2.Button.Secondary}"
                                                       Height="21" Padding="6,0" FontSize="10"
                                                       Content="{DynamicResource VLoc.Inspector.Change}"
                                                       ToolTip="{DynamicResource VLoc.Inspector.Change}"
                                                       Click="BtnChangeHair_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Face -->
                                <Border Style="{StaticResource C2.Card}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{DynamicResource VLoc.Inspector.Face}"
                                                       Style="{StaticResource C2.Text.Card}" />
                                            <TextBlock x:Name="FaceIdText" Text="#20000" FontSize="10"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource VBrush.TextMuted}" />
                                        </Grid>
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="31" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="31" Height="31" CornerRadius="3" ClipToBounds="True"
                                                    Background="{DynamicResource VBrush.Surface2}">
                                                <Image x:Name="FaceThumb" Stretch="Uniform" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="FaceName" Text="—" FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource VBrush.TextPrimary}" />
                                                <Border x:Name="FaceChip" Visibility="Collapsed"
                                                        Background="{DynamicResource VBrush.AccentSoft}"
                                                        CornerRadius="2" Padding="3,0"
                                                        HorizontalAlignment="Left" Margin="0,2,0,0">
                                                    <TextBlock Text="{DynamicResource VLoc.Equip.Equipped}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource VBrush.Accent}" />
                                                </Border>
                                            </StackPanel>
                                            <v:VButton Grid.Column="2" Style="{StaticResource C2.Button.Secondary}"
                                                       Height="21" Padding="6,0" FontSize="10"
                                                       Content="{DynamicResource VLoc.Inspector.Change}"
                                                       ToolTip="{DynamicResource VLoc.Inspector.Change}"
                                                       Click="BtnChangeFace_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Outfit summary -->
                                <Border Style="{StaticResource C2.Card}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{DynamicResource C2Loc.Inspector.Outfit}"
                                                       Style="{StaticResource C2.Text.Card}" />
                                            <TextBlock x:Name="OutfitCount" Text="0 件" FontSize="10"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource VBrush.TextMuted}" />
                                        </Grid>
                                        <ItemsControl x:Name="OutfitSummaryList" Margin="0,5,0,0"
                                                      ItemTemplate="{StaticResource OutfitLineTemplate}" />
                                        <v:VButton x:Name="BtnOutfitDetail" Style="{StaticResource C2.Button.Secondary}"
                                                   Height="24" Margin="0,8,0,0"
                                                   Content="{DynamicResource C2Loc.Inspector.ViewAll}"
                                                   ToolTip="{DynamicResource C2Loc.Inspector.ViewAll}"
                                                   Click="BtnOutfitDetail_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" Background="{DynamicResource VBrush.Surface2}"
                                BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="0,1,0,0"
                                Padding="12,0">
                            <TextBlock Text="{DynamicResource VLoc.AppVersion}" FontSize="10"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource VBrush.TextMuted}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Slim rail shown when the wardrobe column is collapsed -->
                <Border x:Name="BrowserReveal" Grid.Column="1" Width="20"
                        Background="{DynamicResource VBrush.Surface}"
                        BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="0,0,1,0"
                        Visibility="Collapsed">
                    <v:VButton Style="{StaticResource C2.IconButton}" Width="19" Height="40"
                               Margin="0,60,0,0" VerticalAlignment="Top"
                               Padding="0" Variant="Ghost" Click="BtnExpandBrowser_Click"
                               ToolTip="{DynamicResource C2Loc.Browser.Title}"
                               AutomationProperties.Name="{DynamicResource C2Loc.Browser.Title}">
                        <Path Data="{StaticResource VIcon.ChevronRight}" Width="9" Height="9"
                              Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=v:VButton}}" />
                    </v:VButton>
                </Border>
            </Grid>

            <!-- ============================ Status ============================ -->
            <Border Grid.Row="2" Background="{DynamicResource VBrush.Surface}"
                    BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="5" Height="5" Margin="0,0,6,0"
                                 Fill="{DynamicResource VBrush.Success}" />
                        <TextBlock x:Name="StatusLeft" Text="{DynamicResource VLoc.Status.LocalMode}"
                                   FontSize="10"
                                   Foreground="{DynamicResource VBrush.TextMuted}" />
                    </StackPanel>
                    <TextBlock x:Name="StatusRight" Text="3× · 24 FPS · 1:1" FontSize="10"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource VBrush.TextMuted}" />
                </Grid>
            </Border>

            <!-- ============================ Help ============================ -->
            <Grid x:Name="HelpOverlay" Grid.RowSpan="3" Background="{DynamicResource VBrush.Scrim}"
                  Visibility="Collapsed">
                <Border Width="620" MaxHeight="600" Background="{DynamicResource VBrush.Surface}"
                        BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="1"
                        CornerRadius="5" Effect="{DynamicResource VShadow.Window}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="52" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource VLoc.Help.Title}"
                                           Style="{StaticResource C2.Text.Title}" FontSize="17" />
                                <Border Background="{DynamicResource VBrush.Surface2}"
                                        CornerRadius="3" Padding="6,1" Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource VLoc.Help.Subtitle}" FontSize="10"
                                               Foreground="{DynamicResource VBrush.TextMuted}" />
                                </Border>
                            </StackPanel>
                            <v:VButton Width="24" Height="24" Padding="0" Variant="Ghost"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Click="BtnHelpClose_Click"
                                       ToolTip="{DynamicResource VLoc.Window.Close}">
                                <Path Data="{StaticResource VIcon.Close}" Width="10" Height="10"
                                      Stretch="Uniform"
                                      Fill="{DynamicResource VBrush.TextMuted}" />
                            </v:VButton>
                        </Grid>

                        <ScrollViewer Grid.Row="1" Margin="16,0,16,8" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource VLoc.Help.UsageTitle}"
                                           Style="{StaticResource C2.Text.Card}" />
                                <TextBlock Text="{DynamicResource VLoc.Help.UsageStep1}" FontSize="11.5"
                                           TextWrapping="Wrap" Margin="0,5,0,3"
                                           Foreground="{DynamicResource VBrush.TextSecondary}" />
                                <TextBlock Text="{DynamicResource VLoc.Help.UsageStep2}" FontSize="11.5"
                                           TextWrapping="Wrap" Margin="0,0,0,3"
                                           Foreground="{DynamicResource VBrush.TextSecondary}" />
                                <TextBlock Text="{DynamicResource VLoc.Help.UsageStep3}" FontSize="11.5"
                                           TextWrapping="Wrap" Margin="0,0,0,3"
                                           Foreground="{DynamicResource VBrush.TextSecondary}" />
                                <TextBlock Text="{DynamicResource VLoc.Help.UsageStep4}" FontSize="11.5"
                                           TextWrapping="Wrap" Margin="0,0,0,14"
                                           Foreground="{DynamicResource VBrush.TextSecondary}" />

                                <TextBlock Text="{DynamicResource VLoc.Help.BackgroundTitle}"
                                           Style="{StaticResource C2.Text.Card}" />
                                <TextBlock Text="{DynamicResource C2Loc.Help.BackgroundDesc}" FontSize="11.5"
                                           TextWrapping="Wrap" Margin="0,5,0,14"
                                           Foreground="{DynamicResource VBrush.TextSecondary}" />

                                <TextBlock Text="{DynamicResource C2Loc.Help.Cache}"
                                           Style="{StaticResource C2.Text.Card}" />
                                <TextBlock Text="{DynamicResource C2Loc.Help.CacheDesc}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,4,0,6"
                                           Foreground="{DynamicResource VBrush.TextSecondary}" />
                                <v:VButton Style="{StaticResource C2.Button.Secondary}" Height="24"
                                           HorizontalAlignment="Left"
                                           Content="{DynamicResource VLoc.Settings.ClearCache}"
                                           Click="MenuClearCache_Click" />

                                <Border Style="{StaticResource C2.Hairline}" Margin="0,14,0,10" />
                                <TextBlock Text="{DynamicResource C2Loc.Help.Language}"
                                           Style="{StaticResource C2.Text.Card}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <RadioButton x:Name="LangZhCN" GroupName="Language" IsChecked="True"
                                                 Style="{StaticResource C2.FilterChip}" Height="24"
                                                 Content="简体中文" Checked="LangZhCN_Checked" />
                                    <RadioButton x:Name="LangZhTW" GroupName="Language"
                                                 Style="{StaticResource C2.FilterChip}" Height="24"
                                                 Margin="4,0,0,0" Content="繁體中文"
                                                 Checked="LangZhTW_Checked" />
                                    <RadioButton x:Name="LangEnUS" GroupName="Language"
                                                 Style="{StaticResource C2.FilterChip}" Height="24"
                                                 Margin="4,0,0,0" Content="English"
                                                 Checked="LangEnUS_Checked" />
                                </StackPanel>

                                <TextBlock Text="{DynamicResource VLoc.Help.AboutTitle}"
                                           Style="{StaticResource C2.Text.Card}" Margin="0,14,0,0" />
                                <TextBlock Text="{DynamicResource C2Loc.Help.AboutAuthorLine}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{DynamicResource VBrush.TextMuted}" />
                                <TextBlock Text="{DynamicResource C2Loc.Help.AboutCharacter}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{DynamicResource VBrush.TextMuted}" />
                                <TextBlock Text="{DynamicResource C2Loc.Help.AboutLike}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{DynamicResource VBrush.TextMuted}" />
                                <TextBlock Text="{DynamicResource C2Loc.Help.AboutSoftware}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{DynamicResource VBrush.TextMuted}" />
                                <TextBlock Text="{DynamicResource C2Loc.Help.AboutFeatures}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{DynamicResource VBrush.TextMuted}" />
                                <TextBlock Text="{DynamicResource C2Loc.Help.AboutContact}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{DynamicResource VBrush.TextMuted}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </AdornerDecorator>
    </Border>
</Window>








