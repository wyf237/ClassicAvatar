<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <AssemblyTitle>Classic Avatar</AssemblyTitle>
    <Product>Classic Avatar</Product>
    <Company>乔峰的音响</Company>
    <Version>1.0.1</Version>
    <FileVersion>1.0.1.0</FileVersion>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Backgrounds\**" Link="Backgrounds\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft-WindowsAPICodePack-Shell" Version="1.1.5" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dependencies\Avatar.Core\Avatar.Core.csproj" />
    <ProjectReference Include="..\Dependencies\VControls\VControls.csproj" />
    <ProjectReference Include="..\Dependencies\WzReader\WzReader.Core\WzReader.Core.csproj" />
    <ProjectReference Include="..\Dependencies\WzReader\WzReader.Export\WzReader.Export.csproj" />
  </ItemGroup>

  <ItemGroup>

  </ItemGroup>

</Project>



