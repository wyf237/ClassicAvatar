<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:v="clr-namespace:VControls.Controls;assembly=VControls">

    <!-- ============================ Typography ============================ -->
    <Style x:Key="C2.Text.Brand" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource C2.Font.Brand}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextPrimary}" />
    </Style>

    <Style x:Key="C2.Text.Title" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource C2.Font.PageTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextPrimary}" />
    </Style>

    <Style x:Key="C2.Text.Section" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource C2.Font.Section}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextPrimary}" />
    </Style>

    <Style x:Key="C2.Text.Card" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource C2.Font.CardTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextPrimary}" />
    </Style>

    <Style x:Key="C2.Text.Body" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource C2.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextSecondary}" />
    </Style>

    <Style x:Key="C2.Text.Control" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource C2.Font.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextSecondary}" />
    </Style>

    <Style x:Key="C2.Text.Caption" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource C2.Font.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextMuted}" />
    </Style>

    <Style x:Key="C2.Text.Micro" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource C2.Font.Micro}" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextMuted}" />
    </Style>

    <Style x:Key="C2.Text.Mono" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, Segoe UI" />
        <Setter Property="FontSize" Value="{DynamicResource C2.Font.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextMuted}" />
    </Style>

    <!-- Icon path: size is set per use; fill is always bound by the caller. -->
    <Style x:Key="C2.Icon" TargetType="{x:Type Path}">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ============================== Buttons ============================= -->
    <Style x:Key="C2.Button" TargetType="{x:Type v:VButton}" BasedOn="{StaticResource {x:Type v:VButton}}">
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="{DynamicResource C2.Font.Control}" />
        <Setter Property="CornerRadius" Value="{DynamicResource C2.Radius.Control}" />
    </Style>

    <Style x:Key="C2.Button.Primary" TargetType="{x:Type v:VButton}" BasedOn="{StaticResource C2.Button}">
        <Setter Property="Variant" Value="Primary" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="C2.Button.Secondary" TargetType="{x:Type v:VButton}" BasedOn="{StaticResource C2.Button}">
        <Setter Property="Variant" Value="Secondary" />
    </Style>

    <Style x:Key="C2.Button.Ghost" TargetType="{x:Type v:VButton}" BasedOn="{StaticResource C2.Button}">
        <Setter Property="Variant" Value="Ghost" />
    </Style>

    <Style x:Key="C2.IconButton" TargetType="{x:Type v:VButton}" BasedOn="{StaticResource {x:Type v:VButton}}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Variant" Value="Ghost" />
        <Setter Property="CornerRadius" Value="{DynamicResource C2.Radius.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextMuted}" />
    </Style>

    <Style x:Key="C2.IconButton.Close" TargetType="{x:Type v:VButton}" BasedOn="{StaticResource C2.IconButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource VBrush.Danger}" />
                <Setter Property="Foreground" Value="{DynamicResource VBrush.OnAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- =============================== Tabs =============================== -->
    <!-- Browser section tab: text with a 2 px accent underline. -->
    <Style x:Key="C2.Tab" TargetType="{x:Type RadioButton}">
        <Setter Property="Height" Value="31" />
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource C2.Font.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid Background="Transparent">
                        <ContentPresenter Margin="0,0,0,8"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                        <Border x:Name="Line" Width="22" Height="2" HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource VBrush.Accent}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource VBrush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource VBrush.TextPrimary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented option inside a Surface2 track (gender). -->
    <Style x:Key="C2.Segment" TargetType="{x:Type RadioButton}">
        <Setter Property="Height" Value="26" />
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource C2.Font.Control}" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="Bd" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="{DynamicResource C2.Radius.Control}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource VBrush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VBrush.Surface}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource VBrush.BorderStrong}" />
                            <Setter Property="Foreground" Value="{DynamicResource VBrush.TextPrimary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact filter chip (全部 / 收藏 / 最近). -->
    <Style x:Key="C2.FilterChip" TargetType="{x:Type RadioButton}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource C2.Font.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="Bd" Background="Transparent"
                            CornerRadius="{DynamicResource C2.Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VBrush.Surface2}" />
                            <Setter Property="Foreground" Value="{DynamicResource VBrush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VBrush.AccentSoft}" />
                            <Setter Property="Foreground" Value="{DynamicResource VBrush.Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Palette row inside the header popup. -->
    <Style x:Key="C2.PaletteItem" TargetType="{x:Type RadioButton}">
        <Setter Property="Height" Value="38" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="4" Padding="8,0">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VBrush.Surface2}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VBrush.AccentSoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource VBrush.AccentBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ List items =========================== -->
    <!-- 14 part tiles: 40 x 40, icon + micro label, accent-soft when active. -->
    <Style x:Key="C2.PartTile" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bd" Background="{DynamicResource VBrush.Surface2}"
                            BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="{DynamicResource C2.Radius.Control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VBrush.Surface3}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource VBrush.Border}" />
                            <Setter Property="Foreground" Value="{DynamicResource VBrush.TextSecondary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VBrush.AccentSoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource VBrush.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource VBrush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource VBrush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Equipment card: 4 columns, image + name + id. -->
    <Style x:Key="C2.AssetCard" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="72" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bd" Background="{DynamicResource VBrush.Surface}"
                            BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource C2.Radius.Card}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VBrush.Surface2}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource VBrush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VBrush.AccentSoft}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource VBrush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource VBrush.FocusRing}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Outfit library row. -->
    <Style x:Key="C2.LibraryCard" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Width" Value="142" />
        <Setter Property="Height" Value="190" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bd" Background="{DynamicResource VBrush.Surface}"
                            BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource C2.Radius.Card}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VBrush.Surface2}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource VBrush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource VBrush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Colour swatch (skin / hair dye). -->
    <Style x:Key="C2.Swatch" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Ring" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="2"
                            CornerRadius="14" Padding="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource VBrush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource VBrush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource VBrush.FocusRing}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="C2.Swatch.Small" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource C2.Swatch}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
    </Style>

    <!-- ============================= Surfaces ============================ -->
    <Style x:Key="C2.Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource VBrush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VBrush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource C2.Radius.Card}" />
        <Setter Property="Padding" Value="11,9" />
    </Style>

    <Style x:Key="C2.Hairline" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource VBrush.Border}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ========================= VTabControl ========================= -->
    <Style x:Key="C2.TabAdd" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                        <Path Data="{StaticResource VIcon.Plus}" Width="10" Height="10"
                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VBrush.Surface2}" />
                            <Setter Property="Foreground" Value="{DynamicResource VBrush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="C2.TabClose" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                        <Path Data="{StaticResource VIcon.Close}" Width="8" Height="8" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{DynamicResource VBrush.TextMuted}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VBrush.Surface3}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="C2.VTabItem" TargetType="{x:Type v:VTabItem}">
        <Setter Property="Height" Value="30" />
        <Setter Property="MaxWidth" Value="220" />
        <Setter Property="Margin" Value="0,4,2,0" />
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type v:VTabItem}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="1,1,1,0"
                            CornerRadius="4,4,0,0" Padding="9,0,5,0"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,0,7,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding InactiveIndicatorBrush, RelativeSource={RelativeSource AncestorType={x:Type v:VTabControl}}}" />
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Header}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="Medium" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <Button x:Name="PART_CloseButton" Grid.Column="2"
                                    Style="{StaticResource C2.TabClose}" Margin="6,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource VBrush.Surface}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource VBrush.Border}" />
                            <Setter TargetName="Dot" Property="Fill"
                                    Value="{Binding ActiveIndicatorBrush, RelativeSource={RelativeSource AncestorType={x:Type v:VTabControl}}}" />
                            <Setter Property="Foreground" Value="{DynamicResource VBrush.TextPrimary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource VBrush.Surface2}" />
                        </Trigger>
                        <Trigger Property="ShowCloseButton" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="C2.VTabControl" TargetType="{x:Type v:VTabControl}">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ShowIcons" Value="False" />
        <Setter Property="ShowCloseButtons" Value="True" />
        <Setter Property="ShowAddButton" Value="True" />
        <Setter Property="AllowTabDrag" Value="False" />
        <Setter Property="ActiveIndicatorBrush" Value="{DynamicResource VBrush.Accent}" />
        <Setter Property="InactiveIndicatorBrush" Value="{DynamicResource VBrush.BorderStrong}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource C2.VTabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type v:VTabControl}">
                    <Border x:Name="TabStrip" Background="Transparent"
                            BorderBrush="{DynamicResource VBrush.Border}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="PART_TabsScroll" Grid.Column="0"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          CanContentScroll="False" Focusable="False"
                                          PanningMode="HorizontalOnly">
                                <StackPanel Orientation="Horizontal">
                                    <ItemsPresenter />
                                    <Button x:Name="PART_InlineAddButton" Style="{StaticResource C2.TabAdd}"
                                            VerticalAlignment="Center" />
                                </StackPanel>
                            </ScrollViewer>
                            <Button x:Name="PART_PinnedAddButton" Grid.Column="1"
                                    Style="{StaticResource C2.TabAdd}" Visibility="Collapsed"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================= Progress ============================ -->
    <Style x:Key="C2.Progress" TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="3" />
        <Setter Property="Background" Value="{DynamicResource VBrush.ProgressTrack}" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.ProgressFill}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid x:Name="PART_Track" ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="1.5" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}" CornerRadius="1.5" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Scrollbars: no arrow buttons, identical rounded ends. -->
    <ControlTemplate x:Key="C2.ScrollBar.Vertical" TargetType="{x:Type ScrollBar}">
        <Grid Width="8" Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}"
                   ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                  Focusable="False" IsTabStop="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="ScrollThumb" Width="2" HorizontalAlignment="Center" MinHeight="18">
                        <Thumb.Template>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Border Background="{DynamicResource VBrush.BorderStrong}"
                                        CornerRadius="4" Margin="0,2" />
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                  Focusable="False" IsTabStop="False" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ScrollThumb" Property="Width" Value="8" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="C2.ScrollBar.Horizontal" TargetType="{x:Type ScrollBar}">
        <Grid Height="8" Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="False"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}"
                   ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0"
                                  Focusable="False" IsTabStop="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="ScrollThumb" Height="2" VerticalAlignment="Center" MinWidth="18">
                        <Thumb.Template>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Border Background="{DynamicResource VBrush.BorderStrong}"
                                        CornerRadius="4" Margin="2,0" />
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0"
                                  Focusable="False" IsTabStop="False" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ScrollThumb" Property="Height" Value="8" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template" Value="{StaticResource C2.ScrollBar.Vertical}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
                <Setter Property="Template" Value="{StaticResource C2.ScrollBar.Horizontal}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
