    <SolidColorBrush x:Key="VBrush.SliderThumb" Color="#0A9F90" />
    <SolidColorBrush x:Key="VBrush.SliderThumbBorder" Color="#FDFEFA" />
    <SolidColorBrush x:Key="VBrush.SliderTick" Color="#8D8F6C" />

    <!-- C2 additions -->
    <SolidColorBrush x:Key="VBrush.ProgressTrack" Color="#EEF0CD" />
    <SolidColorBrush x:Key="VBrush.ProgressFill" Color="#0A9F90" />
    <SolidColorBrush x:Key="VBrush.MiniSurface" Color="#FDFEFA" />
    <SolidColorBrush x:Key="VBrush.SceneTitleSurface" Color="#D9FFFFFF" />

    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#0F087E72" Offset="0.58" />
        <GradientStop Color="#33076D63" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
