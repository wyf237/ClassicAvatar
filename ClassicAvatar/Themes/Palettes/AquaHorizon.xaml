<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - AquaHorizon - generated by .work/tools/make_themes20.py
        Swatches: #05668D #028090 #00A896 #F0F3BD
        Mode: light - the pale #F0F3BD horizon is the only light color and works as the canvas
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.AquaHorizon</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#FBFCF3" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#FDFEFA" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#F5F6DF" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#EEF0CD" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#F9F9EB" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#F1F3D4" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#E8EBC2" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#E8EBC2" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#DDE198" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#EDEFC7" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#E3E7AA" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#22240D" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#43451A" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#31321B" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#656742" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#8D8F6C" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#F8F9E8" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#0A9F90" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#099385" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#0A9F90" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#098D80" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#ECF7F3" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#E0F3ED" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#A1DAD2" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#54BCB1" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#8C22240D" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#8A7020" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#038275" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="#D13C48" />
    <SolidColorBrush x:Key="VBrush.Info" Color="#2873CD" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#656742" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#31321B" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#31321B" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#067BAB" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#DDEDF0" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#067BAB" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#038275" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#DCEEE9" />
    <SolidColorBrush x:Key="VBrush.StatusOffline" Color="#D13C48" />
    <SolidColorBrush x:Key="VBrush.StatusOfflineSubtle" Color="#F7E5E3" />
    <SolidColorBrush x:Key="VBrush.StatusAway" Color="#8A7020" />
    <SolidColorBrush x:Key="VBrush.StatusAwaySubtle" Color="#EEECDE" />
    <SolidColorBrush x:Key="VBrush.StatusBusy" Color="#D13C48" />
    <SolidColorBrush x:Key="VBrush.StatusBusySubtle" Color="#F7E5E3" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenance" Color="#2873CD" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenanceSubtle" Color="#E1ECF4" />
    <SolidColorBrush x:Key="VBrush.StatusDegraded" Color="#8A7020" />
    <SolidColorBrush x:Key="VBrush.StatusDegradedSubtle" Color="#EEECDE" />
    <SolidColorBrush x:Key="VBrush.StatusNeutral" Color="#8D8F6C" />
    <SolidColorBrush x:Key="VBrush.StatusNeutralSubtle" Color="#F5F6DF" />

    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="#22240D" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="#FAFBF8" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="#999A8E" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="#F5F6DF" />
    <SolidColorBrush x:Key="VBrush.SegmentThumb" Color="#FDFEFA" />
    <SolidColorBrush x:Key="VBrush.SegmentThumbBorder" Color="#E8EBC2" />

    <SolidColorBrush x:Key="VBrush.SliderTrack" Color="#EEF0CD" />
