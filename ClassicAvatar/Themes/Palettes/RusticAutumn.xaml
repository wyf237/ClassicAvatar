    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#9CACB9" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#EDF0F1" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#EDF0F1" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#00A9C3" />
