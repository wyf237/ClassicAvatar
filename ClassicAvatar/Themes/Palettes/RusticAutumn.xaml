    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00151B20" Offset="0" />
        <GradientStop Color="#14F2AC3B" Offset="0.58" />
        <GradientStop Color="#3DD49634" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
