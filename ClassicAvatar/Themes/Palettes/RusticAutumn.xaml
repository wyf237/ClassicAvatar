<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - RusticAutumn - generated by .work/tools/make_themes20.py
        Swatches: #D1495B #EDAE49 #00798C #30638E
        Mode: dark - no near-white swatch, three deep hues; an evening autumn palette
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.RusticAutumn</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#0E1215" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#151B20" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#202830" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#29353E" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#1B2329" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#242E37" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#344049" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#344049" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#405261" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#2D3943" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#364551" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#080B0D" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#1F2B34" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#EDF0F1" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#9CACB9" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#617586" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#1E262D" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#F2AC3B" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#F4BA5B" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#F2AC3B" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#F5C26E" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#2B2A23" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#342F24" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#785C2C" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#F4BB5E" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#B3000000" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#DEB04A" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#4CDC86" />
