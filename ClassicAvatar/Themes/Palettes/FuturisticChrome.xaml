<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - FuturisticChrome - generated by .work/tools/make_themes20.py
        Swatches: #1F1F1F #E0E0E0 #FF4C29 #009FFD
        Mode: dark - chrome black #1F1F1F plus neon signals; the metallic look needs dark
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.FuturisticChrome</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#111111" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#1B1B1B" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#272727" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#333333" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#212121" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#2D2D2D" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#3D3D3D" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#3D3D3D" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#4F4F4F" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#373737" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#434343" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#080A0D" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#222937" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#EEF0F2" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#A1AABD" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#66738D" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#252525" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#19A1F0" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#3BAFF2" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#19A1F0" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#4FB7F3" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#1B2830" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#1B2E39" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#1A577B" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#42B2F3" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#B3000000" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#D7A751" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#51D68F" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="#EF4C39" />
    <SolidColorBrush x:Key="VBrush.Info" Color="#19A1F0" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#A1AABD" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#EEF0F2" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#EEF0F2" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#009FFE" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#172C39" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#009FFE" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#51D68F" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#23352B" />
    <SolidColorBrush x:Key="VBrush.StatusOffline" Color="#EF4C39" />
    <SolidColorBrush x:Key="VBrush.StatusOfflineSubtle" Color="#39221F" />
    <SolidColorBrush x:Key="VBrush.StatusAway" Color="#D7A751" />
    <SolidColorBrush x:Key="VBrush.StatusAwaySubtle" Color="#352F23" />
    <SolidColorBrush x:Key="VBrush.StatusBusy" Color="#EF4C39" />
    <SolidColorBrush x:Key="VBrush.StatusBusySubtle" Color="#39221F" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenance" Color="#19A1F0" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenanceSubtle" Color="#1B2E39" />
    <SolidColorBrush x:Key="VBrush.StatusDegraded" Color="#D7A751" />
    <SolidColorBrush x:Key="VBrush.StatusDegradedSubtle" Color="#352F23" />
    <SolidColorBrush x:Key="VBrush.StatusNeutral" Color="#66738D" />
    <SolidColorBrush x:Key="VBrush.StatusNeutralSubtle" Color="#272727" />

    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="#3B3B3B" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="#EEF0F2" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="#A1AABD" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="#272727" />
    <SolidColorBrush x:Key="VBrush.SegmentThumb" Color="#1B1B1B" />
    <SolidColorBrush x:Key="VBrush.SegmentThumbBorder" Color="#3D3D3D" />

    <SolidColorBrush x:Key="VBrush.SliderTrack" Color="#333333" />
    <SolidColorBrush x:Key="VBrush.SliderActive" Color="#19A1F0" />
    <SolidColorBrush x:Key="VBrush.SliderThumb" Color="#19A1F0" />
    <SolidColorBrush x:Key="VBrush.SliderThumbBorder" Color="#111111" />
    <SolidColorBrush x:Key="VBrush.SliderTick" Color="#66738D" />

    <!-- C2 additions -->
    <SolidColorBrush x:Key="VBrush.ProgressTrack" Color="#333333" />
    <SolidColorBrush x:Key="VBrush.ProgressFill" Color="#19A1F0" />
    <SolidColorBrush x:Key="VBrush.MiniSurface" Color="#1B1B1B" />
    <SolidColorBrush x:Key="VBrush.SceneTitleSurface" Color="#D9494949" />

    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#001B1B1B" Offset="0" />
        <GradientStop Color="#1419A1F0" Offset="0.58" />
        <GradientStop Color="#3D30AAF2" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
