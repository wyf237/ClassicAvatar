<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - NeoDigitalGlow - generated by .work/tools/make_themes20.py
        Swatches: #00F5D4 #FF6B6B #FEE440 #2D00F7
        Mode: dark - neon cyan/yellow over a #2D00F7 deep-indigo base; reads as a dark canvas
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.NeoDigitalGlow</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#110F17" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#1B1925" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#282437" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#343048" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#22202F" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#2E2A40" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#3F3B53" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#3F3B53" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#524B71" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#39344F" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#443F5E" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#0A0910" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#2A253E" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#F0EFF2" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#ABA7C1" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#756E96" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#272435" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#0FE7CA" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#50EED8" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#0FE7CA" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#6EF1DF" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#1A2E36" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#19363C" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#16766F" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#3AEBD4" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#B3000000" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#EFCB39" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#39EFDA" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="#F04A50" />
    <SolidColorBrush x:Key="VBrush.Info" Color="#5986D8" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#ABA7C1" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#F0EFF2" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#F0EFF2" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#00AC95" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#172C34" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#00AC95" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#39EFDA" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#1F373E" />
    <SolidColorBrush x:Key="VBrush.StatusOffline" Color="#F04A50" />
    <SolidColorBrush x:Key="VBrush.StatusOfflineSubtle" Color="#39202B" />
    <SolidColorBrush x:Key="VBrush.StatusAway" Color="#EFCB39" />
    <SolidColorBrush x:Key="VBrush.StatusAwaySubtle" Color="#393228" />
    <SolidColorBrush x:Key="VBrush.StatusBusy" Color="#F04A50" />
    <SolidColorBrush x:Key="VBrush.StatusBusySubtle" Color="#39202B" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenance" Color="#5986D8" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenanceSubtle" Color="#24283E" />
    <SolidColorBrush x:Key="VBrush.StatusDegraded" Color="#EFCB39" />
    <SolidColorBrush x:Key="VBrush.StatusDegradedSubtle" Color="#393228" />
    <SolidColorBrush x:Key="VBrush.StatusNeutral" Color="#756E96" />
    <SolidColorBrush x:Key="VBrush.StatusNeutralSubtle" Color="#282437" />

    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="#3E3857" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="#F0EFF2" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="#ABA7C1" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="#282437" />
    <SolidColorBrush x:Key="VBrush.SegmentThumb" Color="#1B1925" />
    <SolidColorBrush x:Key="VBrush.SegmentThumbBorder" Color="#3F3B53" />

    <SolidColorBrush x:Key="VBrush.SliderTrack" Color="#343048" />
    <SolidColorBrush x:Key="VBrush.SliderActive" Color="#0FE7CA" />
    <SolidColorBrush x:Key="VBrush.SliderThumb" Color="#0FE7CA" />
    <SolidColorBrush x:Key="VBrush.SliderThumbBorder" Color="#110F17" />
    <SolidColorBrush x:Key="VBrush.SliderTick" Color="#756E96" />

    <!-- C2 additions -->
    <SolidColorBrush x:Key="VBrush.ProgressTrack" Color="#343048" />
    <SolidColorBrush x:Key="VBrush.ProgressFill" Color="#0FE7CA" />
    <SolidColorBrush x:Key="VBrush.MiniSurface" Color="#1B1925" />
    <SolidColorBrush x:Key="VBrush.SceneTitleSurface" Color="#D94A4369" />

    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#001B1925" Offset="0" />
        <GradientStop Color="#140FE7CA" Offset="0.58" />
        <GradientStop Color="#3D0CB59F" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
