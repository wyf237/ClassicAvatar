    <SolidColorBrush x:Key="VBrush.SliderThumb" Color="#F2364C" />
    <SolidColorBrush x:Key="VBrush.SliderThumbBorder" Color="#FCFEFE" />
    <SolidColorBrush x:Key="VBrush.SliderTick" Color="#789099" />

    <!-- C2 additions -->
    <SolidColorBrush x:Key="VBrush.ProgressTrack" Color="#E1F0F6" />
    <SolidColorBrush x:Key="VBrush.ProgressFill" Color="#F2364C" />
    <SolidColorBrush x:Key="VBrush.MiniSurface" Color="#FCFEFE" />
    <SolidColorBrush x:Key="VBrush.SceneTitleSurface" Color="#D9FFFFFF" />

    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#0FD12F42" Offset="0.58" />
        <GradientStop Color="#33B7293A" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
