<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - SoftTech - generated by .work/tools/make_themes20.py
        Swatches: #EDF2F4 #8D99AE #EF233C #2B2D42
        Mode: light - #EDF2F4 is a near-white product surface, #2B2D42 the text ink
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.SoftTech</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#F8FBFD" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#FCFEFE" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#ECF5F9" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#E1F0F6" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#F3F9FB" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#E7F2F7" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#D9EAF1" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#D9EAF1" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#C3E0EC" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#DFEFF5" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#CEE6F0" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#11242C" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#214756" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#20343B" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#4B6A76" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#789099" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#F2F8FB" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#F2364C" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#DB3145" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#F2364C" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#D12F42" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#FBF0F2" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#FBE6E9" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#F8B2BA" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#F67282" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#8C11242C" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#976C1E" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#1F8347" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="#E31430" />
    <SolidColorBrush x:Key="VBrush.Info" Color="#3B71D1" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#4B6A76" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#20343B" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#20343B" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#1E817D" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#DFEEED" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#1E817D" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#1F8347" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#DFEEE6" />
    <SolidColorBrush x:Key="VBrush.StatusOffline" Color="#E31430" />
    <SolidColorBrush x:Key="VBrush.StatusOfflineSubtle" Color="#F9E0E3" />
    <SolidColorBrush x:Key="VBrush.StatusAway" Color="#976C1E" />
    <SolidColorBrush x:Key="VBrush.StatusAwaySubtle" Color="#EFEBE1" />
    <SolidColorBrush x:Key="VBrush.StatusBusy" Color="#E31430" />
    <SolidColorBrush x:Key="VBrush.StatusBusySubtle" Color="#F9E0E3" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenance" Color="#3B71D1" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenanceSubtle" Color="#E3ECF8" />
    <SolidColorBrush x:Key="VBrush.StatusDegraded" Color="#976C1E" />
    <SolidColorBrush x:Key="VBrush.StatusDegradedSubtle" Color="#EFEBE1" />
    <SolidColorBrush x:Key="VBrush.StatusNeutral" Color="#789099" />
    <SolidColorBrush x:Key="VBrush.StatusNeutralSubtle" Color="#ECF5F9" />

    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="#11242C" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="#F9FBFB" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="#919A9E" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="#ECF5F9" />
    <SolidColorBrush x:Key="VBrush.SegmentThumb" Color="#FCFEFE" />
    <SolidColorBrush x:Key="VBrush.SegmentThumbBorder" Color="#D9EAF1" />

    <SolidColorBrush x:Key="VBrush.SliderTrack" Color="#E1F0F6" />
