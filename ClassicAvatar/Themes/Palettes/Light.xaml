<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - Light - generated by .work/tools/make_themes20.py
        Swatches: #FFFFFF #F4F5F7 #2563D9 #142231
        Mode: light - neutral product light; white surfaces, ink #142231, restrained #2563D9 accent
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.Light</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#FBFBFD" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#F4F5F7" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#ECEEF2" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#F7F8FA" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#EFF1F4" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#E2E5EA" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#E2E5EA" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#CED3DB" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#E9ECF1" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#DDE2E9" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#142231" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#233447" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#142231" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#4C5A6B" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#7C8798" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#F5F6F8" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#2563D9" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#1D4FB0" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#2563D9" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#1D4FB0" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#EEF4FF" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#E9F0FF" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#BDD0F2" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#6E97E8" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#8C0B1826" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#A9630D" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#16805E" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="#C0392B" />
    <SolidColorBrush x:Key="VBrush.Info" Color="#2563D9" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#4C5A6B" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#142231" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#142231" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#16805E" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#E6F4EF" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#16805E" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#16805E" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#E6F4EF" />
    <SolidColorBrush x:Key="VBrush.StatusOffline" Color="#C0392B" />
    <SolidColorBrush x:Key="VBrush.StatusOfflineSubtle" Color="#FBEAE8" />
    <SolidColorBrush x:Key="VBrush.StatusAway" Color="#B4690E" />
    <SolidColorBrush x:Key="VBrush.StatusAwaySubtle" Color="#FBF1E4" />
    <SolidColorBrush x:Key="VBrush.StatusBusy" Color="#C0392B" />
    <SolidColorBrush x:Key="VBrush.StatusBusySubtle" Color="#FBEAE8" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenance" Color="#2563D9" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenanceSubtle" Color="#E7F0FF" />
    <SolidColorBrush x:Key="VBrush.StatusDegraded" Color="#B4690E" />
    <SolidColorBrush x:Key="VBrush.StatusDegradedSubtle" Color="#FBF1E4" />
    <SolidColorBrush x:Key="VBrush.StatusNeutral" Color="#7C8798" />
    <SolidColorBrush x:Key="VBrush.StatusNeutralSubtle" Color="#F4F5F7" />

    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="#142231" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="#FBFBFD" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="#AFC0CE" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="#F4F5F7" />
    <SolidColorBrush x:Key="VBrush.SegmentThumb" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VBrush.SegmentThumbBorder" Color="#E2E5EA" />

    <SolidColorBrush x:Key="VBrush.SliderTrack" Color="#ECEEF2" />
    <SolidColorBrush x:Key="VBrush.SliderActive" Color="#2563D9" />
    <SolidColorBrush x:Key="VBrush.SliderThumb" Color="#2563D9" />
    <SolidColorBrush x:Key="VBrush.SliderThumbBorder" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VBrush.SliderTick" Color="#7C8798" />

    <!-- C2 additions -->
    <SolidColorBrush x:Key="VBrush.ProgressTrack" Color="#ECEEF2" />
    <SolidColorBrush x:Key="VBrush.ProgressFill" Color="#2563D9" />
    <SolidColorBrush x:Key="VBrush.MiniSurface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VBrush.SceneTitleSurface" Color="#D9FFFFFF" />

    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#0F0B1826" Offset="0.58" />
        <GradientStop Color="#330B1826" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
