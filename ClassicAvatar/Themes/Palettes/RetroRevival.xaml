    <SolidColorBrush x:Key="VBrush.StatusNeutral" Color="#968A75" />
    <SolidColorBrush x:Key="VBrush.StatusNeutralSubtle" Color="#F9F4E9" />

    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="#292110" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="#FBFAF8" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="#9C9890" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="#F9F4E9" />
