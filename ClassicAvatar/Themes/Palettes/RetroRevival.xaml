    <SolidColorBrush x:Key="VBrush.StatusAway" Color="#9F6703" />
    <SolidColorBrush x:Key="VBrush.StatusAwaySubtle" Color="#F2EADC" />
    <SolidColorBrush x:Key="VBrush.StatusBusy" Color="#E70F06" />
