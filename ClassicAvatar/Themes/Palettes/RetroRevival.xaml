<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - RetroRevival - generated by .work/tools/make_themes20.py
        Swatches: #FF5E5B #D8A47F #FFC145 #40476D
        Mode: light - warm cream/amber mid-tones; only one deep color, so a light retro card wins
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.RetroRevival</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#FDFBF6" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#FEFDFC" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#F9F4E9" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#F5EDDC" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#FBF7F1" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#F7EFE1" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#F0E6D3" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#F0E6D3" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#EBDBBA" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#F4EBDA" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#EEE1C5" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#292110" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#50401E" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#38301E" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#716348" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#968A75" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#FAF6EF" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#BE830C" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#AF790B" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#BE830C" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#AA750B" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#FAF4EB" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#F6EEDF" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#E6CFA1" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#D2A855" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#8C292110" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#9F6703" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#1F8342" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="#E70F06" />
    <SolidColorBrush x:Key="VBrush.Info" Color="#3472CF" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#716348" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#38301E" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#38301E" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#1E817D" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#E1EDEB" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#1E817D" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#1F8342" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#E1EDE4" />
