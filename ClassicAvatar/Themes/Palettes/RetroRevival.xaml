    <!-- C2 additions -->
    <SolidColorBrush x:Key="VBrush.ProgressTrack" Color="#F5EDDC" />
    <SolidColorBrush x:Key="VBrush.ProgressFill" Color="#BE830C" />
    <SolidColorBrush x:Key="VBrush.MiniSurface" Color="#FEFDFC" />
    <SolidColorBrush x:Key="VBrush.SceneTitleSurface" Color="#D9FFFFFF" />

    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#0F956609" Offset="0.58" />
        <GradientStop Color="#33825A08" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
