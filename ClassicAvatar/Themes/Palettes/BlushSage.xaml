    <SolidColorBrush x:Key="VBrush.StatusNeutralSubtle" Color="#FBF2F4" />

    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="#3B171C" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="#FBFAFA" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="#A59496" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="#FBF2F4" />
