    <!-- C2 additions -->
    <SolidColorBrush x:Key="VBrush.ProgressTrack" Color="#F9E9EC" />
    <SolidColorBrush x:Key="VBrush.ProgressFill" Color="#539F44" />
    <SolidColorBrush x:Key="VBrush.MiniSurface" Color="#FFFEFE" />
    <SolidColorBrush x:Key="VBrush.SceneTitleSurface" Color="#D9FFFFFF" />

    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#0F417D35" Offset="0.58" />
        <GradientStop Color="#33396D2E" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
