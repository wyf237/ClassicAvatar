<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - BlushSage - generated by .work/tools/make_themes20.py
        Swatches: #FAE0E4 #F7CAD0 #A0D995 #6A8E7F
        Mode: light - two near-white blushes make an obvious light surface, sage is the ink
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.BlushSage</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#FDFAFA" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#FFFEFE" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#FBF2F4" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#F9E9EC" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#FDF7F7" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#FAEEEF" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#F5E2E5" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#F5E2E5" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#F3D5D9" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#F9E8EB" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#F5DCE0" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#3B171C" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#702B36" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#48272C" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#8A575F" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#A28489" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#FCF5F7" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#539F44" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#4C933F" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#539F44" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#4A8D3D" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#F3F7F1" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#EAF3E8" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#BEDAB7" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#87BC7C" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#8C3B171C" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#926D1D" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#1F8543" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="#D6353D" />
    <SolidColorBrush x:Key="VBrush.Info" Color="#3372CF" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#8A575F" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#48272C" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#48272C" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#1E817D" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#E2EEED" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#1E817D" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#1F8543" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#E2EEE6" />
