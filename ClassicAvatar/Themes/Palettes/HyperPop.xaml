    <SolidColorBrush x:Key="VBrush.SliderThumb" Color="#AC8B0B" />
    <SolidColorBrush x:Key="VBrush.SliderThumbBorder" Color="#FEFEFC" />
    <SolidColorBrush x:Key="VBrush.SliderTick" Color="#938D71" />

    <!-- C2 additions -->
    <SolidColorBrush x:Key="VBrush.ProgressTrack" Color="#F4EED7" />
    <SolidColorBrush x:Key="VBrush.ProgressFill" Color="#AC8B0B" />
    <SolidColorBrush x:Key="VBrush.MiniSurface" Color="#FEFEFC" />
    <SolidColorBrush x:Key="VBrush.SceneTitleSurface" Color="#D9FFFFFF" />

    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#0F866C09" Offset="0.58" />
        <GradientStop Color="#33765F08" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
