<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - HyperPop - generated by .work/tools/make_themes20.py
        Swatches: #FF4D6D #F9C80E #00CFC1 #2D00F7
        Mode: light - saturated candy tones on white keep the poster/sticker feel
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.HyperPop</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#FCFBF5" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#FEFEFC" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#F8F4E7" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#F4EED7" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#FAF8EF" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#F6F1DE" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#EEE7CE" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#EEE7CE" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#E8DCB0" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#F3ECD5" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#ECE3BE" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#27220F" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#4B421D" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#36301D" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#6E6545" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#938D71" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#FAF7EE" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#AC8B0B" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#9E800A" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#AC8B0B" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#9A7C0A" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#F8F6EB" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#F4F0DF" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#DFD2A0" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#C5AE54" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#8C27220F" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#926E06" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#0B817F" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="#E60539" />
    <SolidColorBrush x:Key="VBrush.Info" Color="#3B70D5" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#6E6545" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#36301D" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#36301D" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#008279" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#DDEEEB" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#008279" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#0B817F" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#DEEEEC" />
    <SolidColorBrush x:Key="VBrush.StatusOffline" Color="#E60539" />
    <SolidColorBrush x:Key="VBrush.StatusOfflineSubtle" Color="#FBDEE3" />
    <SolidColorBrush x:Key="VBrush.StatusAway" Color="#926E06" />
    <SolidColorBrush x:Key="VBrush.StatusAwaySubtle" Color="#F0EBDC" />
    <SolidColorBrush x:Key="VBrush.StatusBusy" Color="#E60539" />
    <SolidColorBrush x:Key="VBrush.StatusBusySubtle" Color="#FBDEE3" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenance" Color="#3B70D5" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenanceSubtle" Color="#E5ECF7" />
    <SolidColorBrush x:Key="VBrush.StatusDegraded" Color="#926E06" />
    <SolidColorBrush x:Key="VBrush.StatusDegradedSubtle" Color="#F0EBDC" />
    <SolidColorBrush x:Key="VBrush.StatusNeutral" Color="#938D71" />
    <SolidColorBrush x:Key="VBrush.StatusNeutralSubtle" Color="#F8F4E7" />

    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="#27220F" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="#FBFAF8" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="#9C998F" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="#F8F4E7" />
    <SolidColorBrush x:Key="VBrush.SegmentThumb" Color="#FEFEFC" />
    <SolidColorBrush x:Key="VBrush.SegmentThumbBorder" Color="#EEE7CE" />

    <SolidColorBrush x:Key="VBrush.SliderTrack" Color="#F4EED7" />
