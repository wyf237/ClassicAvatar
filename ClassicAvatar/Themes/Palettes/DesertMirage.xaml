<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - DesertMirage - generated by .work/tools/make_themes20.py
        Swatches: #E07A5F #3D405B #81B29A #F2CC8F
        Mode: light - sand #F2CC8F lightens to a warm canvas; #3D405B carries text
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.DesertMirage</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#FDFBF7" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#FEFDFC" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#F9F4EA" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#F6EDDE" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#FBF7F2" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#F7EFE3" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#F1E5D4" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#F1E5D4" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#ECD9BC" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#F5EBDB" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#EFE0C9" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#2B2010" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#533F20" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#392F1E" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#736249" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#978A76" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#FBF6F0" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#E66846" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#D46040" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#E66846" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#CD5D3F" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#FCF3EF" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#FBEBE6" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#F5C4B7" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#EE957E" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#8C2B2010" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#9E6815" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#1F8342" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="#D6363C" />
    <SolidColorBrush x:Key="VBrush.Info" Color="#3272CF" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#736249" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#392F1E" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#392F1E" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#1E817D" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#E1EDEB" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#1E817D" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#1F8342" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#E1EDE4" />
    <SolidColorBrush x:Key="VBrush.StatusOffline" Color="#D6363C" />
    <SolidColorBrush x:Key="VBrush.StatusOfflineSubtle" Color="#F9E3E3" />
    <SolidColorBrush x:Key="VBrush.StatusAway" Color="#9E6815" />
    <SolidColorBrush x:Key="VBrush.StatusAwaySubtle" Color="#F2EADE" />
    <SolidColorBrush x:Key="VBrush.StatusBusy" Color="#D6363C" />
    <SolidColorBrush x:Key="VBrush.StatusBusySubtle" Color="#F9E3E3" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenance" Color="#3272CF" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenanceSubtle" Color="#E3EBF6" />
    <SolidColorBrush x:Key="VBrush.StatusDegraded" Color="#9E6815" />
    <SolidColorBrush x:Key="VBrush.StatusDegradedSubtle" Color="#F2EADE" />
    <SolidColorBrush x:Key="VBrush.StatusNeutral" Color="#978A76" />
    <SolidColorBrush x:Key="VBrush.StatusNeutralSubtle" Color="#F9F4EA" />

    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="#2B2010" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="#FBFAF8" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="#9D9890" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="#F9F4EA" />
    <SolidColorBrush x:Key="VBrush.SegmentThumb" Color="#FEFDFC" />
    <SolidColorBrush x:Key="VBrush.SegmentThumbBorder" Color="#F1E5D4" />

    <SolidColorBrush x:Key="VBrush.SliderTrack" Color="#F6EDDE" />
    <SolidColorBrush x:Key="VBrush.SliderActive" Color="#E66846" />
    <SolidColorBrush x:Key="VBrush.SliderThumb" Color="#E66846" />
    <SolidColorBrush x:Key="VBrush.SliderThumbBorder" Color="#FEFDFC" />
    <SolidColorBrush x:Key="VBrush.SliderTick" Color="#978A76" />

    <!-- C2 additions -->
    <SolidColorBrush x:Key="VBrush.ProgressTrack" Color="#F6EDDE" />
    <SolidColorBrush x:Key="VBrush.ProgressFill" Color="#E66846" />
    <SolidColorBrush x:Key="VBrush.MiniSurface" Color="#FEFDFC" />
    <SolidColorBrush x:Key="VBrush.SceneTitleSurface" Color="#D9FFFFFF" />

    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#0FB45137" Offset="0.58" />
        <GradientStop Color="#339E4730" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
