<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - ArcticSunrise - generated by .work/tools/make_themes20.py
        Swatches: #E0FBFC #98C1D9 #3D5A80 #EE6C4D
        Mode: light - icy #E0FBFC background with #3D5A80 as the dark ink
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.ArcticSunrise</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#F5FCFC" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#FDFEFE" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#E7F8F8" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#D7F2F4" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#EFFAFB" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#DDF4F5" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#CFEDEF" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#CFEDEF" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#AEE6E8" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#D4F2F3" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#BEEBEC" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#0F2526" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#1C494A" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#1D3535" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#456B6D" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#719393" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#EDFAFA" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#F25C39" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#DE5534" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#F25C39" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#D85233" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#FCF3F0" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#FCEBE6" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#F9C0B3" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#F68D74" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#8C0F2526" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#946C23" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#1F834F" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="#D6334C" />
    <SolidColorBrush x:Key="VBrush.Info" Color="#3570D6" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#456B6D" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#1D3535" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#1D3535" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#307AA5" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#E2EDF2" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#307AA5" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#1F834F" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#E0EEE7" />
    <SolidColorBrush x:Key="VBrush.StatusOffline" Color="#D6334C" />
    <SolidColorBrush x:Key="VBrush.StatusOfflineSubtle" Color="#F8E4E7" />
    <SolidColorBrush x:Key="VBrush.StatusAway" Color="#946C23" />
    <SolidColorBrush x:Key="VBrush.StatusAwaySubtle" Color="#EFEBE2" />
    <SolidColorBrush x:Key="VBrush.StatusBusy" Color="#D6334C" />
    <SolidColorBrush x:Key="VBrush.StatusBusySubtle" Color="#F8E4E7" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenance" Color="#3570D6" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenanceSubtle" Color="#E3ECF9" />
    <SolidColorBrush x:Key="VBrush.StatusDegraded" Color="#946C23" />
    <SolidColorBrush x:Key="VBrush.StatusDegradedSubtle" Color="#EFEBE2" />
    <SolidColorBrush x:Key="VBrush.StatusNeutral" Color="#719393" />
    <SolidColorBrush x:Key="VBrush.StatusNeutralSubtle" Color="#E7F8F8" />

    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="#0F2526" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="#F9FAFB" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="#909A9B" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="#E7F8F8" />
    <SolidColorBrush x:Key="VBrush.SegmentThumb" Color="#FDFEFE" />
    <SolidColorBrush x:Key="VBrush.SegmentThumbBorder" Color="#CFEDEF" />

    <SolidColorBrush x:Key="VBrush.SliderTrack" Color="#D7F2F4" />
