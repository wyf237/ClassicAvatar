    <SolidColorBrush x:Key="VBrush.SliderThumbBorder" Color="#FDFEFE" />
    <SolidColorBrush x:Key="VBrush.SliderTick" Color="#719393" />

    <!-- C2 additions -->
    <SolidColorBrush x:Key="VBrush.ProgressTrack" Color="#D7F2F4" />
    <SolidColorBrush x:Key="VBrush.ProgressFill" Color="#F25C39" />
    <SolidColorBrush x:Key="VBrush.MiniSurface" Color="#FDFEFE" />
    <SolidColorBrush x:Key="VBrush.SceneTitleSurface" Color="#D9FFFFFF" />

    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#0FBF482D" Offset="0.58" />
        <GradientStop Color="#33A74027" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
