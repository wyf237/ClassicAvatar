    <!-- C2 additions -->
    <SolidColorBrush x:Key="VBrush.ProgressTrack" Color="#392F40" />
    <SolidColorBrush x:Key="VBrush.ProgressFill" Color="#E87074" />
    <SolidColorBrush x:Key="VBrush.MiniSurface" Color="#1D1821" />
    <SolidColorBrush x:Key="VBrush.SceneTitleSurface" Color="#D952425C" />

    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#001D1821" Offset="0" />
        <GradientStop Color="#14E87074" Offset="0.58" />
        <GradientStop Color="#3DEB8488" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
