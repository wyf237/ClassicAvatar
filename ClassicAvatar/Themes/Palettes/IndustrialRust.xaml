    <SolidColorBrush x:Key="VBrush.StatusDegradedSubtle" Color="#382527" />
    <SolidColorBrush x:Key="VBrush.StatusNeutral" Color="#826992" />
    <SolidColorBrush x:Key="VBrush.StatusNeutralSubtle" Color="#2C2531" />

    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="#44374D" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="#F1EFF2" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="#B4A3BF" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="#2C2531" />
    <SolidColorBrush x:Key="VBrush.SegmentThumb" Color="#1D1821" />
    <SolidColorBrush x:Key="VBrush.SegmentThumbBorder" Color="#443A4B" />

    <SolidColorBrush x:Key="VBrush.SliderTrack" Color="#392F40" />
