<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - IndustrialRust - generated by .work/tools/make_themes20.py
        Swatches: #6D597A #B56576 #E56B6F #EAAC8B
        Mode: dark - no near-white swatch and a low mean luminance; rusted metal reads dark
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.IndustrialRust</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#131015" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#1D1821" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#2C2531" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#392F40" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#261F2A" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#332A38" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#443A4B" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#443A4B" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#5A4A64" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#3E3345" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#4B3F54" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#0C080E" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#32233B" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#F1EFF2" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#B4A3BF" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#826992" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#2B232F" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#E87074" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#EB8488" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#E87074" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#ED8F93" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#312129" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#39242D" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#784046" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#EC8A8D" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#B3000000" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#DD784B" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#51D682" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="#E1585C" />
    <SolidColorBrush x:Key="VBrush.Info" Color="#5183D6" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#B4A3BF" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#F1EFF2" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#F1EFF2" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#28ABA6" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#1E2B32" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#28ABA6" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#51D682" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#24332F" />
    <SolidColorBrush x:Key="VBrush.StatusOffline" Color="#E1585C" />
    <SolidColorBrush x:Key="VBrush.StatusOfflineSubtle" Color="#382129" />
    <SolidColorBrush x:Key="VBrush.StatusAway" Color="#DD784B" />
    <SolidColorBrush x:Key="VBrush.StatusAwaySubtle" Color="#382527" />
    <SolidColorBrush x:Key="VBrush.StatusBusy" Color="#E1585C" />
    <SolidColorBrush x:Key="VBrush.StatusBusySubtle" Color="#382129" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenance" Color="#5183D6" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenanceSubtle" Color="#24273A" />
