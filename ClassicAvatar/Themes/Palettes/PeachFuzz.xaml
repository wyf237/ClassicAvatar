<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - PeachFuzz - generated by .work/tools/make_themes20.py
        Swatches: #FFBE98 #FFEEDB #BA5A31 #3B252C
        Mode: light - cream #FFEEDB is the natural background, clay #BA5A31 the ink-ish accent
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.PeachFuzz</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#FDFAF8" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#FEFDFD" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#FAF3ED" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#F6ECE1" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#FCF8F3" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#F7EFE5" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#F2E6D8" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#F2E6D8" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#EDD9C2" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#F6EADE" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#F1DFCD" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#2C2011" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#573E21" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#3B2E20" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#76614B" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#998A79" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#FBF6F1" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#C44915" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#AA3F12" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#C44915" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#9F3B11" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#FAF0ED" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#F7E7E1" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#E8B9A5" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#D6805B" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#8C2C2011" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#C64D07" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#1F8543" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="#D6353E" />
    <SolidColorBrush x:Key="VBrush.Info" Color="#3472CF" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#76614B" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#3B2E20" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#3B2E20" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#1E817D" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#E1EDEC" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#1E817D" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#1F8543" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#E1EDE5" />
    <SolidColorBrush x:Key="VBrush.StatusOffline" Color="#D6353E" />
    <SolidColorBrush x:Key="VBrush.StatusOfflineSubtle" Color="#F9E3E4" />
    <SolidColorBrush x:Key="VBrush.StatusAway" Color="#C64D07" />
    <SolidColorBrush x:Key="VBrush.StatusAwaySubtle" Color="#F7E6DD" />
    <SolidColorBrush x:Key="VBrush.StatusBusy" Color="#D6353E" />
    <SolidColorBrush x:Key="VBrush.StatusBusySubtle" Color="#F9E3E4" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenance" Color="#3472CF" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenanceSubtle" Color="#E4EBF7" />
    <SolidColorBrush x:Key="VBrush.StatusDegraded" Color="#C64D07" />
    <SolidColorBrush x:Key="VBrush.StatusDegradedSubtle" Color="#F7E6DD" />
    <SolidColorBrush x:Key="VBrush.StatusNeutral" Color="#998A79" />
    <SolidColorBrush x:Key="VBrush.StatusNeutralSubtle" Color="#FAF3ED" />

    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="#2C2011" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="#FBFAF8" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="#9E9890" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="#FAF3ED" />
    <SolidColorBrush x:Key="VBrush.SegmentThumb" Color="#FEFDFD" />
    <SolidColorBrush x:Key="VBrush.SegmentThumbBorder" Color="#F2E6D8" />

    <SolidColorBrush x:Key="VBrush.SliderTrack" Color="#F6ECE1" />
