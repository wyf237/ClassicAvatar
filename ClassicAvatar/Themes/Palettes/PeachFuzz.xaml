    <!-- C2 additions -->
    <SolidColorBrush x:Key="VBrush.ProgressTrack" Color="#F6ECE1" />
    <SolidColorBrush x:Key="VBrush.ProgressFill" Color="#C44915" />
    <SolidColorBrush x:Key="VBrush.MiniSurface" Color="#FEFDFD" />
    <SolidColorBrush x:Key="VBrush.SceneTitleSurface" Color="#D9FFFFFF" />

    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#0FC04815" Offset="0.58" />
        <GradientStop Color="#33A93F12" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
