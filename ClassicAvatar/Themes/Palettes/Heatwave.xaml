<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - Heatwave - generated by .work/tools/make_themes20.py
        Swatches: #FF1E56 #FFAC41 #2E294E #1B998B
        Mode: dark - hot signals on a #2E294E night base; mean luminance is low
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.Heatwave</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#110F17" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#1A1925" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#272537" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#333048" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#22202F" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#2D2A40" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#3F3B53" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#3F3B53" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#514C71" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#38344F" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#433F5F" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#0A0A10" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#29253E" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#EFEFF2" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#AAA7C1" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#736E96" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#262435" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#F4B159" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#F6BD74" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#F4B159" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#F7C585" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#30282A" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#392E2C" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#7C5D3C" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#F6BF77" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#B3000000" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#EF9A39" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#51D6C4" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="#F0466D" />
    <SolidColorBrush x:Key="VBrush.Info" Color="#5184D6" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#AAA7C1" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#EFEFF2" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#EFEFF2" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#1EAB9C" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#1B2C34" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#1EAB9C" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#51D6C4" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#22333B" />
    <SolidColorBrush x:Key="VBrush.StatusOffline" Color="#F0466D" />
    <SolidColorBrush x:Key="VBrush.StatusOfflineSubtle" Color="#381F2F" />
    <SolidColorBrush x:Key="VBrush.StatusAway" Color="#EF9A39" />
    <SolidColorBrush x:Key="VBrush.StatusAwaySubtle" Color="#382B28" />
    <SolidColorBrush x:Key="VBrush.StatusBusy" Color="#F0466D" />
    <SolidColorBrush x:Key="VBrush.StatusBusySubtle" Color="#381F2F" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenance" Color="#5184D6" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenanceSubtle" Color="#22283E" />
    <SolidColorBrush x:Key="VBrush.StatusDegraded" Color="#EF9A39" />
    <SolidColorBrush x:Key="VBrush.StatusDegradedSubtle" Color="#382B28" />
    <SolidColorBrush x:Key="VBrush.StatusNeutral" Color="#736E96" />
    <SolidColorBrush x:Key="VBrush.StatusNeutralSubtle" Color="#272537" />

    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="#3C3858" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="#EFEFF2" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="#AAA7C1" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="#272537" />
    <SolidColorBrush x:Key="VBrush.SegmentThumb" Color="#1A1925" />
    <SolidColorBrush x:Key="VBrush.SegmentThumbBorder" Color="#3F3B53" />

    <SolidColorBrush x:Key="VBrush.SliderTrack" Color="#333048" />
    <SolidColorBrush x:Key="VBrush.SliderActive" Color="#F4B159" />
    <SolidColorBrush x:Key="VBrush.SliderThumb" Color="#F4B159" />
    <SolidColorBrush x:Key="VBrush.SliderThumbBorder" Color="#110F17" />
    <SolidColorBrush x:Key="VBrush.SliderTick" Color="#736E96" />

    <!-- C2 additions -->
    <SolidColorBrush x:Key="VBrush.ProgressTrack" Color="#333048" />
    <SolidColorBrush x:Key="VBrush.ProgressFill" Color="#F4B159" />
    <SolidColorBrush x:Key="VBrush.MiniSurface" Color="#1A1925" />
    <SolidColorBrush x:Key="VBrush.SceneTitleSurface" Color="#D949446A" />

    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#001A1925" Offset="0" />
        <GradientStop Color="#14F4B159" Offset="0.58" />
        <GradientStop Color="#3DD0974C" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
