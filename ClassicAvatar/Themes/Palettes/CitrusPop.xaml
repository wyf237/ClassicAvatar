<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - CitrusPop - generated by .work/tools/make_themes20.py
        Swatches: #FFB400 #FF6363 #FFE156 #2D00F7
        Mode: light - bright citrus mid-tones over a single deep blue; light surfaces keep it juicy
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.CitrusPop</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#FCFBF4" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#FEFDFB" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#F8F5E6" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#F3EDD5" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#FAF9EF" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#F5F1DC" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#EEE7CB" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#EEE7CB" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#E7DCAC" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#F2EDD2" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#EBE2BA" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#27220F" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#4B421C" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#35311C" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#6C6645" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#928C70" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#FAF7ED" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#B8850C" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#A97A0B" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#B8850C" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#A4770B" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#F9F5EA" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#F6EFDE" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#E3CFA0" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#CDAA55" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#8C27220F" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#9B6A02" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#1F8444" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="#E60A06" />
    <SolidColorBrush x:Key="VBrush.Info" Color="#3672D0" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#6C6645" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#35311C" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#35311C" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#1E817D" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#E1EDEB" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#1E817D" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#1F8444" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#E1EDE3" />
    <SolidColorBrush x:Key="VBrush.StatusOffline" Color="#E60A06" />
    <SolidColorBrush x:Key="VBrush.StatusOfflineSubtle" Color="#FBDDDB" />
    <SolidColorBrush x:Key="VBrush.StatusAway" Color="#9B6A02" />
    <SolidColorBrush x:Key="VBrush.StatusAwaySubtle" Color="#F1EADB" />
    <SolidColorBrush x:Key="VBrush.StatusBusy" Color="#E60A06" />
    <SolidColorBrush x:Key="VBrush.StatusBusySubtle" Color="#FBDDDB" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenance" Color="#3672D0" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenanceSubtle" Color="#E4EBF5" />
    <SolidColorBrush x:Key="VBrush.StatusDegraded" Color="#9B6A02" />
    <SolidColorBrush x:Key="VBrush.StatusDegradedSubtle" Color="#F1EADB" />
    <SolidColorBrush x:Key="VBrush.StatusNeutral" Color="#928C70" />
    <SolidColorBrush x:Key="VBrush.StatusNeutralSubtle" Color="#F8F5E6" />

    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="#27220F" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="#FBFAF8" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="#9C998F" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="#F8F5E6" />
    <SolidColorBrush x:Key="VBrush.SegmentThumb" Color="#FEFDFB" />
    <SolidColorBrush x:Key="VBrush.SegmentThumbBorder" Color="#EEE7CB" />

    <SolidColorBrush x:Key="VBrush.SliderTrack" Color="#F3EDD5" />
    <SolidColorBrush x:Key="VBrush.SliderActive" Color="#B8850C" />
    <SolidColorBrush x:Key="VBrush.SliderThumb" Color="#B8850C" />
    <SolidColorBrush x:Key="VBrush.SliderThumbBorder" Color="#FEFDFB" />
    <SolidColorBrush x:Key="VBrush.SliderTick" Color="#928C70" />

    <!-- C2 additions -->
    <SolidColorBrush x:Key="VBrush.ProgressTrack" Color="#F3EDD5" />
    <SolidColorBrush x:Key="VBrush.ProgressFill" Color="#B8850C" />
    <SolidColorBrush x:Key="VBrush.MiniSurface" Color="#FEFDFB" />
    <SolidColorBrush x:Key="VBrush.SceneTitleSurface" Color="#D9FFFFFF" />

    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#0F916809" Offset="0.58" />
        <GradientStop Color="#337F5B08" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
