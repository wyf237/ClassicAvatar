    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="#2C4042" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="#ECF0F1" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="#92B0B2" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="#1E2A2B" />
