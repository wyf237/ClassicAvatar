    <!-- C2 additions -->
    <SolidColorBrush x:Key="VBrush.ProgressTrack" Color="#273637" />
    <SolidColorBrush x:Key="VBrush.ProgressFill" Color="#5EB270" />
    <SolidColorBrush x:Key="VBrush.MiniSurface" Color="#141B1C" />
    <SolidColorBrush x:Key="VBrush.SceneTitleSurface" Color="#D9364C4F" />

    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00141B1C" Offset="0" />
        <GradientStop Color="#145EB270" Offset="0.58" />
        <GradientStop Color="#3D61B372" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
