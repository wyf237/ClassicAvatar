<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - LushForest - generated by .work/tools/make_themes20.py
        Swatches: #354F52 #52796F #84A98C #CAD2C5
        Mode: dark - deep canopy greens dominate; #CAD2C5 is too dim to be a window surface
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.LushForest</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#0D1212" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#141B1C" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#1E2A2B" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#273637" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#1A2325" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#222F31" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#324042" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#324042" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#3D5456" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#2A3A3D" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#334649" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#070A0B" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#1B2B2D" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#ECF0F1" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#92B0B2" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#59787C" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#1D2729" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#5EB270" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#74BC83" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#5EB270" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#81C38F" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#1B2A24" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#1E3028" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#355F42" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#7BC08A" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#B3000000" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#D6B751" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#4CDC89" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="#D95E66" />
    <SolidColorBrush x:Key="VBrush.Info" Color="#4D90DB" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#92B0B2" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#ECF0F1" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#ECF0F1" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#28ABA6" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#172E2E" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#28ABA6" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#4CDC89" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#1C362B" />
    <SolidColorBrush x:Key="VBrush.StatusOffline" Color="#D95E66" />
