<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - Dark - generated by .work/tools/make_themes20.py
        Swatches: #111016 #17151D #D6B36A #F3F0F7
        Mode: dark - neutral product dark; #111016 window, #17151D surface, gold #D6B36A accent
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.Dark</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#111016" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#17151D" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#1E1B25" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#26222E" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#1A1720" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#221E2A" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#2E2938" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#2E2938" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#3D3648" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#201C29" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#2A2534" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#0C0B10" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#201D26" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#F3F0F7" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#BDB6C9" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#8A8397" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#1B181F" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#D6B36A" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#E2C57F" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#1A1620" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#D6B36A" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#E7CB8E" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#2E2718" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#241F15" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#5C4C2C" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#17131B" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#EBD7A6" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#B3000000" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#E0A44B" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#4FBF95" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="#EE6A5F" />
    <SolidColorBrush x:Key="VBrush.Info" Color="#7FB3F0" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#BDB6C9" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#F3F0F7" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#F3F0F7" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#4FBF95" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#17302A" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#6FD3B0" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#4FBF95" />
