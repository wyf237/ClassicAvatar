    <!-- C2 additions -->
    <SolidColorBrush x:Key="VBrush.ProgressTrack" Color="#26222E" />
    <SolidColorBrush x:Key="VBrush.ProgressFill" Color="#D6B36A" />
    <SolidColorBrush x:Key="VBrush.MiniSurface" Color="#17151D" />
    <SolidColorBrush x:Key="VBrush.SceneTitleSurface" Color="#D926222E" />

    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0017151D" Offset="0" />
        <GradientStop Color="#14D6B36A" Offset="0.58" />
        <GradientStop Color="#3DD6B36A" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
