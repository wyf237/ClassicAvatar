    <SolidColorBrush x:Key="VBrush.StatusNeutral" Color="#8A8397" />
    <SolidColorBrush x:Key="VBrush.StatusNeutralSubtle" Color="#1E1B25" />

    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="#26222E" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="#F3F0F7" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="#BDB6C9" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="#1E1B25" />
