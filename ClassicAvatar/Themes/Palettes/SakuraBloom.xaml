<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - SakuraBloom - generated by .work/tools/make_themes20.py
        Swatches: #F7D9E3 #FFD6BA #A9DEF9 #E4C1F9
        Mode: light - all four swatches are pastels, so the whole UI is a light bloom
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.SakuraBloom</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#FDF9FB" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#FFFEFE" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#FBF2F5" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#F9E9EF" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#FDF7F9" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#FAEDF1" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#F5E2E9" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#F5E2E9" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#F3D5DF" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#F8E8EE" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#F5DCE4" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#3B1622" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#702A42" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#482732" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#885667" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#A2848F" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#FCF5F8" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#4A97BE" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#448BAF" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#4A97BE" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#4287A9" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#F2F7FA" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#E9F2F6" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#BAD7E6" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#80B6D2" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#8C3B1622" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#976A1F" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#1F834C" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="#D73249" />
    <SolidColorBrush x:Key="VBrush.Info" Color="#1973D0" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#885667" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#482732" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#482732" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#0C7AB1" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#DFEDF4" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#0C7AB1" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#1F834C" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#E2EEE7" />
    <SolidColorBrush x:Key="VBrush.StatusOffline" Color="#D73249" />
    <SolidColorBrush x:Key="VBrush.StatusOfflineSubtle" Color="#FAE3E6" />
    <SolidColorBrush x:Key="VBrush.StatusAway" Color="#976A1F" />
    <SolidColorBrush x:Key="VBrush.StatusAwaySubtle" Color="#F1EBE1" />
    <SolidColorBrush x:Key="VBrush.StatusBusy" Color="#D73249" />
    <SolidColorBrush x:Key="VBrush.StatusBusySubtle" Color="#FAE3E6" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenance" Color="#1973D0" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenanceSubtle" Color="#E1ECF8" />
    <SolidColorBrush x:Key="VBrush.StatusDegraded" Color="#976A1F" />
    <SolidColorBrush x:Key="VBrush.StatusDegradedSubtle" Color="#F1EBE1" />
    <SolidColorBrush x:Key="VBrush.StatusNeutral" Color="#A2848F" />
    <SolidColorBrush x:Key="VBrush.StatusNeutralSubtle" Color="#FBF2F5" />

    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="#3B1622" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="#FBFAFA" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="#A59399" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="#FBF2F5" />
    <SolidColorBrush x:Key="VBrush.SegmentThumb" Color="#FFFEFE" />
    <SolidColorBrush x:Key="VBrush.SegmentThumbBorder" Color="#F5E2E9" />

    <SolidColorBrush x:Key="VBrush.SliderTrack" Color="#F9E9EF" />
