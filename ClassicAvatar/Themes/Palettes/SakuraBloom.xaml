    <SolidColorBrush x:Key="VBrush.SliderThumbBorder" Color="#FFFEFE" />
    <SolidColorBrush x:Key="VBrush.SliderTick" Color="#A2848F" />

    <!-- C2 additions -->
    <SolidColorBrush x:Key="VBrush.ProgressTrack" Color="#F9E9EF" />
    <SolidColorBrush x:Key="VBrush.ProgressFill" Color="#4A97BE" />
    <SolidColorBrush x:Key="VBrush.MiniSurface" Color="#FFFEFE" />
    <SolidColorBrush x:Key="VBrush.SceneTitleSurface" Color="#D9FFFFFF" />

    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#0F3A7694" Offset="0.58" />
        <GradientStop Color="#33326782" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
