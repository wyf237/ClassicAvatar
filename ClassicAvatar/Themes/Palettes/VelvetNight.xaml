    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="#393959" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="#EFEFF2" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="#A7A7C2" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="#262638" />
