<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - VelvetNight - generated by .work/tools/make_themes20.py
        Swatches: #1B1B3A #69306D #A5668B #D3BCC0
        Mode: dark - three of four swatches are deep velvet purples
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.VelvetNight</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#101019" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#191926" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#262638" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#303049" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#202030" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#2B2B40" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#3C3C54" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#3C3C54" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#4D4D73" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#363650" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#404060" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#0A0A10" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#262640" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#EFEFF2" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#A7A7C2" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#707097" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#242436" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#C480A8" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#CB90B3" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#C480A8" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#D09AB9" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#2A2333" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#312738" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#664760" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#CF97B8" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#B3000000" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#D9A54F" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#51D68E" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="#DF596D" />
    <SolidColorBrush x:Key="VBrush.Info" Color="#5885DC" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#A7A7C2" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#EFEFF2" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#EFEFF2" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#28ABA6" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#1B2C37" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#28ABA6" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#51D68E" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#213335" />
    <SolidColorBrush x:Key="VBrush.StatusOffline" Color="#DF596D" />
