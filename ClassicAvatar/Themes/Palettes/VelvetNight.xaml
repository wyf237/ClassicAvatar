    <SolidColorBrush x:Key="VBrush.ProgressTrack" Color="#303049" />
    <SolidColorBrush x:Key="VBrush.ProgressFill" Color="#C480A8" />
    <SolidColorBrush x:Key="VBrush.MiniSurface" Color="#191926" />
    <SolidColorBrush x:Key="VBrush.SceneTitleSurface" Color="#D944446C" />

    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00191926" Offset="0" />
        <GradientStop Color="#14C480A8" Offset="0.58" />
        <GradientStop Color="#3DCB90B3" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
