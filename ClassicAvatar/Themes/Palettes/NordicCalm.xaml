    <!-- C2 additions -->
    <SolidColorBrush x:Key="VBrush.ProgressTrack" Color="#EDEDED" />
    <SolidColorBrush x:Key="VBrush.ProgressFill" Color="#BF7B88" />
    <SolidColorBrush x:Key="VBrush.MiniSurface" Color="#FDFDFD" />
    <SolidColorBrush x:Key="VBrush.SceneTitleSurface" Color="#D9FFFFFF" />

    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#0F96616B" Offset="0.58" />
        <GradientStop Color="#3383555D" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
