<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - NordicCalm - generated by .work/tools/make_themes20.py
        Swatches: #E8E8E4 #D8E2DC #FFCAD4 #9D8189
        Mode: light - three pale neutrals; a light, airy Nordic room
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.NordicCalm</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#FAFAFA" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#FDFDFD" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#F5F5F5" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#EDEDED" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#F8F8F8" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#F1F1F1" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#E8E8E8" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#E8E8E8" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#DCDCDC" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#ECECEC" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#E1E1E1" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#162139" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#2A4170" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#263146" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#556686" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#828DA0" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#F6F6F6" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#BF7B88" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#B0717D" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#BF7B88" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#AA6E79" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#F9F4F5" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#F6EDEF" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#E5CCD1" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#D2A3AC" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#8C162139" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#966C1E" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#1F8345" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="#D73341" />
    <SolidColorBrush x:Key="VBrush.Info" Color="#3A70D1" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#556686" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#263146" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#263146" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#1E817D" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#E0EDEC" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#1E817D" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#1F8345" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#E0EDE5" />
    <SolidColorBrush x:Key="VBrush.StatusOffline" Color="#D73341" />
    <SolidColorBrush x:Key="VBrush.StatusOfflineSubtle" Color="#F8E3E5" />
    <SolidColorBrush x:Key="VBrush.StatusAway" Color="#966C1E" />
    <SolidColorBrush x:Key="VBrush.StatusAwaySubtle" Color="#F0EAE0" />
    <SolidColorBrush x:Key="VBrush.StatusBusy" Color="#D73341" />
    <SolidColorBrush x:Key="VBrush.StatusBusySubtle" Color="#F8E3E5" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenance" Color="#3A70D1" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenanceSubtle" Color="#E4EBF7" />
