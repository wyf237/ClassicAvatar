    <SolidColorBrush x:Key="VBrush.StatusDegradedSubtle" Color="#F0EAE0" />
    <SolidColorBrush x:Key="VBrush.StatusNeutral" Color="#828DA0" />
    <SolidColorBrush x:Key="VBrush.StatusNeutralSubtle" Color="#F5F5F5" />

    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="#162139" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="#F9FAFB" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="#9398A4" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="#F5F5F5" />
