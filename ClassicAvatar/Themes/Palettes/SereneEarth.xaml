<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - SereneEarth - generated by .work/tools/make_themes20.py
        Swatches: #C9ADA7 #9A8C98 #F2E9E4 #22223B
        Mode: light - near-white #F2E9E4 plus the ink #22223B anchor a light, papery surface
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.SereneEarth</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#FDFAF9" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#FEFDFD" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#FAF2EE" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#F7EBE5" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#FCF7F4" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#F9EFE9" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#F3E5DC" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#F3E5DC" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#F0D7CA" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#F7E9E2" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#F2DFD4" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#311E13" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#603924" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#3F2D22" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#7C5F4F" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#9C887D" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#FCF6F3" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#BB7F73" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#AC7569" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#BB7F73" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#A77166" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#F9F4F3" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#F6EEEC" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#E5CDC9" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#CFA59D" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#8C311E13" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#976C1E" />
