    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#7C5F4F" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#3F2D22" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#3F2D22" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#1E817D" />
