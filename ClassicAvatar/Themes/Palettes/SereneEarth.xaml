    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#0F93645A" Offset="0.58" />
        <GradientStop Color="#3381574F" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
