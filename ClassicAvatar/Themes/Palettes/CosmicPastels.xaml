    <SolidColorBrush x:Key="VBrush.StatusDegraded" Color="#966C1E" />
    <SolidColorBrush x:Key="VBrush.StatusDegradedSubtle" Color="#F0EBE0" />
    <SolidColorBrush x:Key="VBrush.StatusNeutral" Color="#7F926F" />
    <SolidColorBrush x:Key="VBrush.StatusNeutralSubtle" Color="#EEF7E5" />

    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="#19260E" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="#F9FBF8" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="#949B8F" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="#EEF7E5" />
