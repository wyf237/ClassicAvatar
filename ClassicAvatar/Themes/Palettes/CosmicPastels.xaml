<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        C2 palette - CosmicPastels - generated by .work/tools/make_themes20.py
        Swatches: #B5EAEA #EDF6E5 #FFBCBC #F38BA0
        Mode: light - all pastel, nothing darker than mid-tone; light mode is the only fit
        Every VBrush.* key used by VControls and the workbench is present here,
        so ApplyTheme can swap this dictionary without a missing-resource pass.
    -->
    <sys:String x:Key="VControls.ThemeName">C2.CosmicPastels</sys:String>

    <SolidColorBrush x:Key="VBrush.Window" Color="#F8FCF5" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="#FDFEFD" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="#EEF7E5" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="#E2F3D4" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="#F4FAEE" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="#E7F5DB" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="#DBEDCB" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#DBEDCB" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="#C6E6A9" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#E0F2D0" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="#D0EBB8" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="#19260E" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="#31491C" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="#28351C" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="#576C44" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="#7F926F" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="#F2FAEC" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="#DB6A81" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="#C96177" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="#DB6A81" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="#C35E73" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="#FBF4F4" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="#F9ECEE" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="#F0C6CE" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="#0E0D12" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="#E697A7" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#8C19260E" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="#966C1E" />
    <SolidColorBrush x:Key="VBrush.Success" Color="#1F8344" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="#E11B3E" />
    <SolidColorBrush x:Key="VBrush.Info" Color="#3970D0" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="#576C44" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#28351C" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#28351C" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#248080" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#E1EEED" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#248080" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#1F8344" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#E0EEE5" />
    <SolidColorBrush x:Key="VBrush.StatusOffline" Color="#E11B3E" />
    <SolidColorBrush x:Key="VBrush.StatusOfflineSubtle" Color="#F9E0E4" />
