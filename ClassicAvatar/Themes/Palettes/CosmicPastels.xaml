    <!-- C2 additions -->
    <SolidColorBrush x:Key="VBrush.ProgressTrack" Color="#E2F3D4" />
    <SolidColorBrush x:Key="VBrush.ProgressFill" Color="#DB6A81" />
    <SolidColorBrush x:Key="VBrush.MiniSurface" Color="#FDFEFD" />
    <SolidColorBrush x:Key="VBrush.SceneTitleSurface" Color="#D9FFFFFF" />

    <LinearGradientBrush x:Key="VBrush.PreviewWash" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#0FAC5366" Offset="0.58" />
        <GradientStop Color="#33964959" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
