<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Generic.xaml is loaded automatically for the VControls assembly.
        It supplies the Light theme as a safe fallback and all control styles.
        Each control style dictionary merges the shared token dictionaries it
        needs, so StaticResource references stay self-contained.

        Applications can override the semantic brush keys by merging
        Themes/Dark.xaml (or a custom theme) at Application scope.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Light.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Resources/Icons.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Controls/VCornerRadioButton.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Controls/VButton.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Controls/VComboBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Controls/VTextBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Controls/VToolTip.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Controls/VListBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Controls/VMenu.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Controls/VCard.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Controls/VStatus.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Controls/VDialog.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Controls/VSegmentedControl.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Controls/VSelect.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Controls/VSlider.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Controls/VTabControl.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Controls/VVirtualList.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
