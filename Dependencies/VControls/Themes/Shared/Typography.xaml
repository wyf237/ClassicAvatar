<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Modern UI typography. shadcn-like compact scale: 13px body,
         12px controls, 16px section headings and 24px page titles. -->
    <FontFamily x:Key="VFont.Family">Microsoft YaHei UI, Segoe UI Variable, Segoe UI, sans-serif</FontFamily>

    <sys:Double x:Key="VFont.Size.Caption">11</sys:Double>
    <sys:Double x:Key="VFont.Size.Body">13</sys:Double>
    <sys:Double x:Key="VFont.Size.Button">12</sys:Double>
    <sys:Double x:Key="VFont.Size.Subheading">14</sys:Double>
    <sys:Double x:Key="VFont.Size.Heading">16</sys:Double>
    <sys:Double x:Key="VFont.Size.Title">24</sys:Double>
    <sys:Double x:Key="VFont.Size.Display">34</sys:Double>
</ResourceDictionary>
