<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VControls.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Shared/Typography.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Shared/Metrics.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Shared/Motion.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Self-contained footer button so the dialog dictionary does not depend
         on VButton.xaml merge order. Tag=Primary swaps the hover tint for a
         light overlay on the dark primary surface. -->
    <Style x:Key="VDialogButton" TargetType="{x:Type Button}">
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource VFont.Size.Button}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="HoverLayer"
                                    Background="{DynamicResource VBrush.HoverOverlay}"
                                    CornerRadius="5"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Primary">
                            <Setter TargetName="HoverLayer" Property="Background" Value="{DynamicResource VBrush.OnPrimary}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverLayer" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverLayer" Property="Opacity" Value="0.16" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource VBrush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="{StaticResource VControl.DisabledOpacity}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:VDialog}">
        <Setter Property="Background" Value="{DynamicResource VBrush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VBrush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextPrimary}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource VFont.Size.Body}" />
        <Setter Property="DialogWidth" Value="{DynamicResource VControl.Dialog.Width}" />
        <Setter Property="CornerRadius" Value="{DynamicResource VRadius.Dialog}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="ConfirmBackground" Value="{DynamicResource VBrush.Primary}" />
        <Setter Property="ConfirmForeground" Value="{DynamicResource VBrush.OnPrimary}" />
        <Setter Property="ConfirmBorderBrush" Value="Transparent" />
        <Setter Property="CancelBackground" Value="{DynamicResource VBrush.Surface}" />
        <Setter Property="CancelForeground" Value="{DynamicResource VBrush.TextPrimary}" />
        <Setter Property="CancelBorderBrush" Value="{DynamicResource VBrush.Border}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:VDialog}">
                    <Grid>
                        <Border x:Name="Card"
                                Width="{TemplateBinding DialogWidth}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                Effect="{DynamicResource VShadow.Dialog}"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock x:Name="TitleText"
                                               Text="{TemplateBinding Title}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{TemplateBinding Foreground}"
                                               TextWrapping="Wrap"
                                               LineHeight="24" />
                                    <TextBlock x:Name="MessageText"
                                               Text="{TemplateBinding Message}"
                                               Margin="0,8,0,0"
                                               FontSize="13"
                                               Foreground="{DynamicResource VBrush.TextSecondary}"
                                               TextWrapping="Wrap"
                                               LineHeight="20" />
                                </StackPanel>

                                <ContentPresenter x:Name="BodyHost"
                                                  Grid.Row="1"
                                                  Margin="0,18,0,0"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}" />

                                <StackPanel x:Name="Footer"
                                            Grid.Row="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,24,0,0">
                                    <Button x:Name="PART_CancelButton"
                                            Style="{StaticResource VDialogButton}"
                                            Tag="Secondary"
                                            Content="{TemplateBinding CancelText}"
                                            Background="{TemplateBinding CancelBackground}"
                                            Foreground="{TemplateBinding CancelForeground}"
                                            BorderBrush="{TemplateBinding CancelBorderBrush}"
                                            Margin="0,0,8,0" />
                                    <Button x:Name="PART_ConfirmButton"
                                            Style="{StaticResource VDialogButton}"
                                            Tag="Primary"
                                            Content="{TemplateBinding ConfirmText}"
                                            Background="{TemplateBinding ConfirmBackground}"
                                            Foreground="{TemplateBinding ConfirmForeground}"
                                            BorderBrush="{TemplateBinding ConfirmBorderBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="MessageText" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Message" Value="">
                            <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="BodyHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowCancelButton" Value="False">
                            <Setter TargetName="PART_CancelButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowConfirmButton" Value="False">
                            <Setter TargetName="PART_ConfirmButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
