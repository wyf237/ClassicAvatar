<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:VControls.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Shared/Typography.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Shared/Metrics.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Shared/Motion.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Themed TextBox: surface background, 1px border, subtle focus ring. -->
    <Style x:Key="VTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="{DynamicResource VControl.Input.Height}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource VFont.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource VBrush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VBrush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource VBrush.TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource VBrush.AccentSubtle}" />
        <Setter Property="SelectionOpacity" Value="0.8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Left" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="FocusRing"
                                Margin="-2"
                                Background="Transparent"
                                CornerRadius="6"
                                BorderBrush="{DynamicResource VBrush.FocusRing}"
                                BorderThickness="2"
                                Opacity="0"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True" />
                        <!-- Padding is applied by the TextBox itself; adding it a
                             second time as a margin pushed the caret to the middle. -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      Background="Transparent" />
                        <TextBlock x:Name="Placeholder"
                                   Margin="{TemplateBinding Padding}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource VBrush.TextMuted}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Text="{Binding Path=(local:VTextBox.Placeholder), RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VBrush.SurfaceMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="0.65" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource VBrush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value="" />
                                <Condition Property="IsKeyboardFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Search TextBox with a leading search icon. -->
    <Style x:Key="VSearchBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource VTextBox}">
        <Setter Property="Padding" Value="30,0,10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True" />
                        <Border x:Name="FocusRing"
                                Margin="-2"
                                Background="Transparent"
                                CornerRadius="6"
                                BorderBrush="{DynamicResource VBrush.FocusRing}"
                                BorderThickness="2"
                                Opacity="0"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True" />
                        <Path HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="10,0,0,0"
                              Width="13"
                              Height="13"
                              Stretch="Uniform"
                              Fill="{DynamicResource VBrush.TextMuted}"
                              Data="M9.5 3A6.5 6.5 0 1 1 3 9.5a6.5 6.5 0 0 1 6.5-6.5m0-1a7.5 7.5 0 1 0 4.57 13.16l3.14 3.14a1 1 0 0 0 1.41-1.41l-3.14-3.14A7.5 7.5 0 0 0 9.5 2z" />
                        <ScrollViewer x:Name="PART_ContentHost"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      Background="Transparent" />
                        <TextBlock x:Name="Placeholder"
                                   Margin="{TemplateBinding Padding}"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource VBrush.TextMuted}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Text="{Binding Path=(local:VTextBox.Placeholder), RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VBrush.SurfaceMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="0.65" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource VBrush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value="" />
                                <Condition Property="IsKeyboardFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
