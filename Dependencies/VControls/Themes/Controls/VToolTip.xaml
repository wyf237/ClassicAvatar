<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VControls.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Shared/Typography.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Shared/Metrics.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Classic ToolTip style, kept for ordinary ToolTip instances. -->
    <Style x:Key="VToolTip" TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource VBrush.TooltipBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TooltipForeground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:VToolTip}">
        <Setter Property="Background" Value="{DynamicResource VBrush.TooltipBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TooltipForeground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="{DynamicResource VRadius.Control}" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Placement" Value="Top" />
        <Setter Property="HorizontalOffset" Value="0" />
        <Setter Property="VerticalOffset" Value="4" />
        <Setter Property="ShowArrow" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:VToolTip}">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                <Path x:Name="IconPath"
                                      Data="{TemplateBinding Icon}"
                                      Width="{TemplateBinding IconSize}"
                                      Height="{TemplateBinding IconSize}"
                                      Margin="{TemplateBinding IconMargin}"
                                      Fill="{TemplateBinding Foreground}"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      SnapsToDevicePixels="True" />
                                <ContentPresenter ContentSource="Content"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </StackPanel>
                        </Border>

                        <Path x:Name="Arrow"
                              Width="10"
                              Height="6"
                              Fill="{TemplateBinding Background}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Bottom"
                              Data="M0,0 L5,6 L10,0 Z"
                              Stretch="Fill"
                              Visibility="Collapsed"
                              SnapsToDevicePixels="True" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Placement" Value="Top">
                            <Setter TargetName="Card" Property="Margin" Value="0,0,0,6" />
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Arrow" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="Arrow" Property="VerticalAlignment" Value="Bottom" />
                            <Setter TargetName="Arrow" Property="Width" Value="10" />
                            <Setter TargetName="Arrow" Property="Height" Value="6" />
                            <Setter TargetName="Arrow" Property="Data" Value="M0,0 L5,6 L10,0 Z" />
                        </Trigger>
                        <Trigger Property="Placement" Value="Bottom">
                            <Setter TargetName="Card" Property="Margin" Value="0,6,0,0" />
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Arrow" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="Arrow" Property="VerticalAlignment" Value="Top" />
                            <Setter TargetName="Arrow" Property="Width" Value="10" />
                            <Setter TargetName="Arrow" Property="Height" Value="6" />
                            <Setter TargetName="Arrow" Property="Data" Value="M0,6 L5,0 L10,6 Z" />
                        </Trigger>
                        <Trigger Property="Placement" Value="Left">
                            <Setter TargetName="Card" Property="Margin" Value="0,0,6,0" />
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Arrow" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Arrow" Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="Arrow" Property="Width" Value="6" />
                            <Setter TargetName="Arrow" Property="Height" Value="10" />
                            <Setter TargetName="Arrow" Property="Data" Value="M0,0 L6,5 L0,10 Z" />
                        </Trigger>
                        <Trigger Property="Placement" Value="Right">
                            <Setter TargetName="Card" Property="Margin" Value="6,0,0,0" />
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Arrow" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="Arrow" Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="Arrow" Property="Width" Value="6" />
                            <Setter TargetName="Arrow" Property="Height" Value="10" />
                            <Setter TargetName="Arrow" Property="Data" Value="M6,0 L0,5 L6,10 Z" />
                        </Trigger>
                        <Trigger Property="ShowArrow" Value="False">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Card" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconPath" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconPath" Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
