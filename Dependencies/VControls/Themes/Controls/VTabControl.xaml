<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VControls.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Shared/Typography.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Shared/Metrics.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="VTabBooleanToVisibility" />

    <Style x:Key="VTabAddButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextSecondary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTip" Value="新建标签" />
        <Setter Property="AutomationProperties.Name" Value="新建标签" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="HoverLayer"
                                    Background="{DynamicResource VBrush.HoverOverlay}"
                                    CornerRadius="5"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                            <Path Width="12"
                                  Height="12"
                                  Data="M8,3 H10 V8 H15 V10 H10 V15 H8 V10 H3 V8 H8 Z"
                                  Fill="{TemplateBinding Foreground}"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  SnapsToDevicePixels="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverLayer" Property="Opacity" Value="0.055" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverLayer" Property="Opacity" Value="0.10" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="{StaticResource VControl.DisabledOpacity}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VTabCloseButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type controls:VTabItem}}}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ToolTip" Value="关闭" />
        <Setter Property="AutomationProperties.Name" Value="关闭" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <Path Width="10"
                              Height="10"
                              Data="M2,2 L10,10 M10,2 L2,10"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              SnapsToDevicePixels="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VBrush.SurfaceMuted}" />
                            <Setter Property="Foreground" Value="{DynamicResource VBrush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VBrush.SurfaceSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VTabScrollButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource VBrush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VBrush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VBrush.SurfaceMuted}" />
                            <Setter Property="Foreground" Value="{DynamicResource VBrush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource VBrush.SurfaceSoft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:VTabItem}">
        <Setter Property="Height" Value="30" />
        <Setter Property="MaxWidth" Value="240" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource VFont.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:VTabItem}">
                    <Border x:Name="Root"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="6"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Grid>
                            <Border x:Name="HoverLayer"
                                    Background="{DynamicResource VBrush.HoverOverlay}"
                                    CornerRadius="5"
                                    Opacity="0"
                                    IsHitTestVisible="False" />

                            <Grid Margin="9,0,7,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse x:Name="StatusDot"
                                         Grid.Column="0"
                                         Width="6"
                                         Height="6"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding InactiveIndicatorBrush, RelativeSource={RelativeSource AncestorType={x:Type controls:VTabControl}}}" />

                                <Path x:Name="IconPath"
                                      Grid.Column="1"
                                      Data="{TemplateBinding Icon}"
                                      Width="{TemplateBinding IconSize}"
                                      Height="{TemplateBinding IconSize}"
                                      Margin="0,0,6,0"
                                      Fill="{TemplateBinding Foreground}"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding IsIconVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VTabBooleanToVisibility}}"
                                      SnapsToDevicePixels="True" />

                                <TextBlock x:Name="HeaderText"
                                           Grid.Column="2"
                                           Text="{TemplateBinding Header}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />

                                <Button x:Name="PART_CloseButton"
                                        Grid.Column="3"
                                        Style="{StaticResource VTabCloseButton}"
                                        Margin="8,0,0,0" />
                            </Grid>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource VBrush.Surface}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource VBrush.SegmentThumbBorder}" />
                            <Setter TargetName="Root" Property="Effect" Value="{DynamicResource VShadow.Segment}" />
                            <Setter TargetName="StatusDot"
                                    Property="Fill"
                                    Value="{Binding ActiveIndicatorBrush, RelativeSource={RelativeSource AncestorType={x:Type controls:VTabControl}}}" />
                            <Setter Property="Foreground" Value="{DynamicResource VBrush.TextPrimary}" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverLayer" Property="Opacity" Value="0.045" />
                        </Trigger>

                        <Trigger Property="ShowCloseButton" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <DataTrigger Binding="{Binding ShowCloseButtons, RelativeSource={RelativeSource AncestorType={x:Type controls:VTabControl}}}"
                                     Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource VControl.DisabledOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:VTabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource VFont.Size.Body}" />
        <Setter Property="MinWidth" Value="{DynamicResource VControl.Tab.MinWidth}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="ShowIcons" Value="True" />
        <Setter Property="ShowCloseButtons" Value="True" />
        <Setter Property="ShowAddButton" Value="True" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="ScrollButtonVisibility" Value="Overflow" />
        <Setter Property="ActiveIndicatorBrush" Value="{DynamicResource VBrush.StatusOnline}" />
        <Setter Property="InactiveIndicatorBrush" Value="{DynamicResource VBrush.StatusNeutral}" />
        <Setter Property="TabStripPlacement" Value="Top" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:VTabControl}">
                    <controls:VTabRootPanel>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border x:Name="TabStrip"
                                Grid.Row="0"
                                Background="{DynamicResource VBrush.SegmentTrack}"
                                BorderBrush="{DynamicResource VBrush.Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="3"
                                SnapsToDevicePixels="True"
                                UseLayoutRounding="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button x:Name="PART_ScrollLeftButton"
                                        Grid.Column="0"
                                        Style="{StaticResource VTabScrollButton}"
                                        VerticalAlignment="Center"
                                        Margin="3,0,0,0"
                                        Visibility="Collapsed"
                                        ToolTip="向前翻页">
                                    <Path Width="9"
                                          Height="9"
                                          Data="M7,2 L3,6 L7,10"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                          StrokeThickness="1.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Stretch="Uniform" />
                                </Button>

                                <ScrollViewer x:Name="PART_TabsScroll"
                                              Grid.Column="1"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              CanContentScroll="False"
                                              Focusable="False"
                                              PanningMode="HorizontalOnly">
                                    <ScrollViewer.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                                            <GradientStop Color="#FFFFFFFF" Offset="0.94" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </ScrollViewer.OpacityMask>
                                    <StackPanel Orientation="Horizontal">
                                        <ItemsPresenter />
                                        <Button x:Name="PART_InlineAddButton"
                                                Style="{StaticResource VTabAddButton}"
                                                Margin="3,0,0,0"
                                                VerticalAlignment="Center" />
                                    </StackPanel>
                                </ScrollViewer>

                                <Button x:Name="PART_ScrollRightButton"
                                        Grid.Column="2"
                                        Style="{StaticResource VTabScrollButton}"
                                        VerticalAlignment="Center"
                                        Margin="3,0,0,0"
                                        Visibility="Collapsed"
                                        ToolTip="向后翻页">
                                    <Path Width="9"
                                          Height="9"
                                          Data="M3,2 L7,6 L3,10"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                          StrokeThickness="1.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Stretch="Uniform" />
                                </Button>

                                <Button x:Name="PART_PinnedAddButton"
                                        Grid.Column="3"
                                        Style="{StaticResource VTabAddButton}"
                                        Margin="3,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Margin="0,12,0,0"
                                Background="Transparent">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Border>
                    </controls:VTabRootPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
