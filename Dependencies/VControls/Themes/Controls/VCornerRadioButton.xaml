<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VControls.Controls">

    <!-- Token dictionaries are merged into the style dictionary so
         StaticResource references below resolve in a self-contained file. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Shared/Typography.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Shared/Metrics.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Shared/Motion.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type controls:VCornerRadioButton}">
        <!-- DynamicResource lets an application override these metric keys
             without editing the library. Local Width/Height on an instance
             still takes precedence. -->
        <Setter Property="Width" Value="{DynamicResource VControl.Button.Width}" />
        <Setter Property="Height" Value="{DynamicResource VControl.Button.Height}" />
        <Setter Property="MinWidth" Value="{DynamicResource VControl.Button.MinWidth}" />
        <Setter Property="MinHeight" Value="{DynamicResource VControl.Button.MinHeight}" />
        <Setter Property="Padding" Value="{DynamicResource VControl.Button.Padding}" />
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource VFont.Size.Button}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <!-- Semantic theme brushes. They are DynamicResource so theme changes
             update every instance without rebuilding the template. -->
        <Setter Property="CornerRadius" Value="{DynamicResource VRadius.Control}" />
        <Setter Property="CheckedBackground" Value="{DynamicResource VBrush.Surface}" />
        <Setter Property="UncheckedBackground" Value="Transparent" />
        <Setter Property="CheckedForeground" Value="{DynamicResource VBrush.TextPrimary}" />
        <Setter Property="UncheckedForeground" Value="{DynamicResource VBrush.TextSecondary}" />
        <Setter Property="CheckedIconBrush" Value="{DynamicResource VBrush.TextPrimary}" />
        <Setter Property="UncheckedIconBrush" Value="{DynamicResource VBrush.TextMuted}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:VCornerRadioButton}">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Grid>
                            <Border x:Name="StateBackground"
                                    Background="{TemplateBinding CurrentBackground}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Margin="{TemplateBinding CheckedBackgroundMargin}"
                                    SnapsToDevicePixels="True"
                                    UseLayoutRounding="True" />
                            <!-- Hover and press tints are independent layers so they
                                 can fade independently and never paint over content. -->
                            <Border x:Name="HoverLayer"
                                    Background="{DynamicResource VBrush.HoverOverlay}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    IsHitTestVisible="False"
                                    Opacity="0"
                                    SnapsToDevicePixels="True" />
                            <Border x:Name="PressedLayer"
                                    Background="{DynamicResource VBrush.PressedOverlay}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    IsHitTestVisible="False"
                                    Opacity="0"
                                    SnapsToDevicePixels="True" />

                            <Border x:Name="Indicator"
                                    Width="2"
                                    Margin="2,8,0,8"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    CornerRadius="1"
                                    Background="{TemplateBinding CheckedIndicatorBrush}"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False" />

                            <Grid Margin="{TemplateBinding Padding}">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="{TemplateBinding ContentOrientation}">
                                    <Path x:Name="IconPath"
                                          Width="{TemplateBinding IconSize}"
                                          Height="{TemplateBinding IconSize}"
                                          Margin="{TemplateBinding IconMargin}"
                                          Data="{TemplateBinding Icon}"
                                          Fill="{TemplateBinding CurrentIconBrush}"
                                          Stretch="Uniform"
                                          SnapsToDevicePixels="True" />

                                    <ContentPresenter x:Name="TextContent"
                                                      ContentSource="Content"
                                                      RecognizesAccessKey="True"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      TextElement.FontFamily="{TemplateBinding FontFamily}"
                                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                                      TextElement.FontStyle="{TemplateBinding FontStyle}"
                                                      TextElement.FontWeight="{TemplateBinding FontWeight}"
                                                      TextElement.Foreground="{TemplateBinding CurrentForeground}" />
                                </StackPanel>
                            </Grid>

                            <Border x:Name="FocusRing"
                                    Margin="-2"
                                    BorderBrush="{DynamicResource VBrush.FocusRing}"
                                    BorderThickness="2"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="ShowCheckedIndicator" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="StateBackground" Property="Effect" Value="{DynamicResource VShadow.Segment}" />
                        </MultiTrigger>

                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconPath" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="HasText" Value="False">
                            <Setter TargetName="TextContent" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconPath" Property="Margin" Value="0" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.055"
                                                         Duration="0:0:0.18"
                                                         EasingFunction="{StaticResource VMotion.Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.22"
                                                         EasingFunction="{StaticResource VMotion.Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.09"
                                                         Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource VMotion.Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressedLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.2"
                                                         EasingFunction="{StaticResource VMotion.Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="0.6" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root"
                                    Property="Opacity"
                                    Value="{StaticResource VControl.DisabledOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
