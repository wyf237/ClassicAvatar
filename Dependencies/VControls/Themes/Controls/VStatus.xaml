<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VControls.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Shared/Typography.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Shared/Metrics.xaml" />
        <ResourceDictionary Source="pack://application:,,,/VControls;component/Themes/Shared/Motion.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Kibo-inspired status badge: rounded surface, semantic dot, ping ring. -->
    <Style TargetType="{x:Type controls:VStatus}">
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="FontFamily" Value="{DynamicResource VFont.Family}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource VBrush.TextSecondary}" />
        <Setter Property="Background" Value="{DynamicResource VBrush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VBrush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="DotSize" Value="7" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="AutomationProperties.Name"
                Value="{Binding DisplayText, RelativeSource={RelativeSource Self}}" />

        <Setter Property="DotBrush" Value="{DynamicResource VBrush.StatusOnline}" />
        <Setter Property="TextBrush" Value="{DynamicResource VBrush.TextSecondary}" />
        <Setter Property="BadgeBackground" Value="{DynamicResource VBrush.Surface}" />
        <Setter Property="BadgeBorderBrush" Value="{DynamicResource VBrush.Border}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:VStatus}">
                    <Border x:Name="Badge"
                            Background="{TemplateBinding BadgeBackground}"
                            BorderBrush="{TemplateBinding BadgeBorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Grid Width="{TemplateBinding DotSize}"
                                  Height="{TemplateBinding DotSize}"
                                  Margin="0,0,7,0"
                                  VerticalAlignment="Center">
                                <Ellipse x:Name="Pulse"
                                         Fill="{TemplateBinding DotBrush}"
                                         Opacity="0"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse Fill="{TemplateBinding DotBrush}" />
                            </Grid>
                            <TextBlock x:Name="Label"
                                       Text="{TemplateBinding DisplayText}"
                                       Foreground="{TemplateBinding TextBrush}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowPulse" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PulseStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Pulse"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0.45"
                                                         To="0"
                                                         Duration="0:0:1.8"
                                                         EasingFunction="{StaticResource VMotion.Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetName="Pulse"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="1"
                                                         To="2.4"
                                                         Duration="0:0:1.8" />
                                        <DoubleAnimation Storyboard.TargetName="Pulse"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="1"
                                                         To="2.4"
                                                         Duration="0:0:1.8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Badge" Property="Opacity" Value="{StaticResource VControl.DisabledOpacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="Status" Value="Online">
                <Setter Property="DotBrush" Value="{DynamicResource VBrush.StatusOnline}" />
            </Trigger>
            <Trigger Property="Status" Value="Offline">
                <Setter Property="DotBrush" Value="{DynamicResource VBrush.StatusOffline}" />
            </Trigger>
            <Trigger Property="Status" Value="Away">
                <Setter Property="DotBrush" Value="{DynamicResource VBrush.StatusAway}" />
            </Trigger>
            <Trigger Property="Status" Value="Busy">
                <Setter Property="DotBrush" Value="{DynamicResource VBrush.StatusBusy}" />
            </Trigger>
            <Trigger Property="Status" Value="Maintenance">
                <Setter Property="DotBrush" Value="{DynamicResource VBrush.StatusMaintenance}" />
            </Trigger>
            <Trigger Property="Status" Value="Degraded">
                <Setter Property="DotBrush" Value="{DynamicResource VBrush.StatusDegraded}" />
            </Trigger>
            <Trigger Property="Status" Value="Custom">
                <Setter Property="DotBrush" Value="{DynamicResource VBrush.StatusNeutral}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
