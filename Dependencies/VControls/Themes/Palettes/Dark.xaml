<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Obsidian palette (dark)
        =======================
        The dark counterpart of Porcelain: near-black surfaces, zinc borders,
        an inverted near-white primary and the same semantic accent roles.
    -->

    <Color x:Key="VColor.Primary.50">#1F1F23</Color>
    <Color x:Key="VColor.Primary.100">#27272A</Color>
    <Color x:Key="VColor.Primary.500">#A1A1AA</Color>
    <Color x:Key="VColor.Primary.600">#D4D4D8</Color>
    <Color x:Key="VColor.Primary.700">#E4E4E7</Color>
    <Color x:Key="VColor.Primary.800">#FAFAFA</Color>
    <Color x:Key="VColor.Primary.900">#FAFAFA</Color>

    <Color x:Key="VColor.Neutral.0">#18181B</Color>
    <Color x:Key="VColor.Neutral.50">#1F1F23</Color>
    <Color x:Key="VColor.Neutral.100">#27272A</Color>
    <Color x:Key="VColor.Neutral.200">#3F3F46</Color>
    <Color x:Key="VColor.Neutral.300">#52525B</Color>
    <Color x:Key="VColor.Neutral.400">#71717A</Color>
    <Color x:Key="VColor.Neutral.500">#A1A1AA</Color>
    <Color x:Key="VColor.Neutral.600">#D4D4D8</Color>
    <Color x:Key="VColor.Neutral.700">#E4E4E7</Color>
    <Color x:Key="VColor.Neutral.800">#FAFAFA</Color>
    <Color x:Key="VColor.Neutral.900">#FAFAFA</Color>
    <Color x:Key="VColor.Neutral.950">#FFFFFF</Color>

    <Color x:Key="VColor.Accent">#FAFAFA</Color>
    <Color x:Key="VColor.Success">#4ADE80</Color>
    <Color x:Key="VColor.Warning">#FBBF24</Color>
    <Color x:Key="VColor.Danger">#F87171</Color>
    <Color x:Key="VColor.Info">#60A5FA</Color>
    <Color x:Key="VColor.Window">#09090B</Color>

    <SolidColorBrush x:Key="VBrush.Window" Color="{StaticResource VColor.Window}" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="{StaticResource VColor.Neutral.0}" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="{StaticResource VColor.Neutral.50}" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="{StaticResource VColor.Neutral.100}" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="{StaticResource VColor.Neutral.100}" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="{StaticResource VColor.Neutral.200}" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="{StaticResource VColor.Neutral.100}" />
    <SolidColorBrush x:Key="VBrush.Border" Color="#3F3F46" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="{StaticResource VColor.Neutral.300}" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="#0C0C0E" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="{StaticResource VColor.Neutral.0}" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="{StaticResource VColor.Window}" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="{StaticResource VColor.Neutral.0}" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="{StaticResource VColor.Neutral.900}" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="{StaticResource VColor.Neutral.500}" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="{StaticResource VColor.Neutral.400}" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="{StaticResource VColor.Neutral.50}" />

    <SolidColorBrush x:Key="VBrush.Primary" Color="{StaticResource VColor.Neutral.900}" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="{StaticResource VColor.Neutral.700}" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="{StaticResource VColor.Neutral.0}" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="{StaticResource VColor.Neutral.900}" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="{StaticResource VColor.Neutral.950}" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="{StaticResource VColor.Neutral.100}" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="{StaticResource VColor.Neutral.50}" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="{StaticResource VColor.Neutral.200}" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="{StaticResource VColor.Neutral.0}" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="{StaticResource VColor.Neutral.300}" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#99000000" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="{StaticResource VColor.Warning}" />
    <SolidColorBrush x:Key="VBrush.Success" Color="{StaticResource VColor.Success}" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="{StaticResource VColor.Danger}" />
    <SolidColorBrush x:Key="VBrush.Info" Color="{StaticResource VColor.Info}" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="{StaticResource VColor.Neutral.500}" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="#FFFFFF" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#2DD4BF" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#042F2E" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#5EEAD4" />

    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#4ADE80" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#052E16" />
    <SolidColorBrush x:Key="VBrush.StatusOffline" Color="#F87171" />
    <SolidColorBrush x:Key="VBrush.StatusOfflineSubtle" Color="#450A0A" />
    <SolidColorBrush x:Key="VBrush.StatusAway" Color="#FBBF24" />
    <SolidColorBrush x:Key="VBrush.StatusAwaySubtle" Color="#451A03" />
    <SolidColorBrush x:Key="VBrush.StatusBusy" Color="#F87171" />
    <SolidColorBrush x:Key="VBrush.StatusBusySubtle" Color="#450A0A" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenance" Color="#60A5FA" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenanceSubtle" Color="#172554" />
    <SolidColorBrush x:Key="VBrush.StatusDegraded" Color="#FBBF24" />
    <SolidColorBrush x:Key="VBrush.StatusDegradedSubtle" Color="#451A03" />
    <SolidColorBrush x:Key="VBrush.StatusNeutral" Color="#A1A1AA" />
    <SolidColorBrush x:Key="VBrush.StatusNeutralSubtle" Color="#27272A" />

    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="{StaticResource VColor.Neutral.800}" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="{StaticResource VColor.Neutral.0}" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="{StaticResource VColor.Neutral.300}" />

    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="{StaticResource VColor.Neutral.100}" />
    <SolidColorBrush x:Key="VBrush.SegmentThumb" Color="#3F3F46" />
    <SolidColorBrush x:Key="VBrush.SegmentThumbBorder" Color="{StaticResource VColor.Neutral.300}" />

    <SolidColorBrush x:Key="VBrush.SliderTrack" Color="{StaticResource VColor.Neutral.200}" />
    <SolidColorBrush x:Key="VBrush.SliderActive" Color="{StaticResource VColor.Neutral.900}" />
    <SolidColorBrush x:Key="VBrush.SliderThumb" Color="{StaticResource VColor.Neutral.900}" />
    <SolidColorBrush x:Key="VBrush.SliderThumbBorder" Color="{StaticResource VColor.Neutral.900}" />
    <SolidColorBrush x:Key="VBrush.SliderTick" Color="{StaticResource VColor.Neutral.400}" />
</ResourceDictionary>
