<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Porcelain palette (light)
        =========================
        A restrained, shadcn-inspired neutral system: white surfaces, zinc
        structure, a near-black primary and small semantic accents used only
        for status, validation and focus. Components consume VBrush.* keys;
        raw values live under VColor.* and should not be used by views.
    -->

    <Color x:Key="VColor.Primary.50">#FAFAFA</Color>
    <Color x:Key="VColor.Primary.100">#F4F4F5</Color>
    <Color x:Key="VColor.Primary.500">#3F3F46</Color>
    <Color x:Key="VColor.Primary.600">#27272A</Color>
    <Color x:Key="VColor.Primary.700">#18181B</Color>
    <Color x:Key="VColor.Primary.800">#18181B</Color>
    <Color x:Key="VColor.Primary.900">#09090B</Color>

    <Color x:Key="VColor.Neutral.0">#FFFFFF</Color>
    <Color x:Key="VColor.Neutral.50">#FAFAFA</Color>
    <Color x:Key="VColor.Neutral.100">#F4F4F5</Color>
    <Color x:Key="VColor.Neutral.200">#E4E4E7</Color>
    <Color x:Key="VColor.Neutral.300">#D4D4D8</Color>
    <Color x:Key="VColor.Neutral.400">#A1A1AA</Color>
    <Color x:Key="VColor.Neutral.500">#71717A</Color>
    <Color x:Key="VColor.Neutral.600">#52525B</Color>
    <Color x:Key="VColor.Neutral.700">#3F3F46</Color>
    <Color x:Key="VColor.Neutral.800">#27272A</Color>
    <Color x:Key="VColor.Neutral.900">#18181B</Color>
    <Color x:Key="VColor.Neutral.950">#09090B</Color>

    <Color x:Key="VColor.Accent">#18181B</Color>
    <Color x:Key="VColor.Success">#16A34A</Color>
    <Color x:Key="VColor.Warning">#D97706</Color>
    <Color x:Key="VColor.Danger">#DC2626</Color>
    <Color x:Key="VColor.Info">#2563EB</Color>
    <Color x:Key="VColor.Window">#F4F4F5</Color>

    <SolidColorBrush x:Key="VBrush.Window" Color="{StaticResource VColor.Window}" />
    <SolidColorBrush x:Key="VBrush.Surface" Color="{StaticResource VColor.Neutral.0}" />
    <SolidColorBrush x:Key="VBrush.Surface2" Color="{StaticResource VColor.Neutral.50}" />
    <SolidColorBrush x:Key="VBrush.Surface3" Color="{StaticResource VColor.Neutral.200}" />
    <SolidColorBrush x:Key="VBrush.SurfaceMuted" Color="{StaticResource VColor.Neutral.100}" />
    <SolidColorBrush x:Key="VBrush.SurfaceSoft" Color="{StaticResource VColor.Neutral.200}" />
    <SolidColorBrush x:Key="VBrush.CardBorder" Color="{StaticResource VColor.Neutral.200}" />
    <SolidColorBrush x:Key="VBrush.Border" Color="{StaticResource VColor.Neutral.200}" />
    <SolidColorBrush x:Key="VBrush.BorderStrong" Color="{StaticResource VColor.Neutral.300}" />
    <SolidColorBrush x:Key="VBrush.Stage" Color="{StaticResource VColor.Neutral.100}" />
    <SolidColorBrush x:Key="VBrush.StageDeep" Color="{StaticResource VColor.Neutral.200}" />
    <SolidColorBrush x:Key="VBrush.DarkPanel" Color="{StaticResource VColor.Neutral.900}" />
    <SolidColorBrush x:Key="VBrush.DarkPanelRaised" Color="{StaticResource VColor.Neutral.800}" />
    <SolidColorBrush x:Key="VBrush.TextPrimary" Color="{StaticResource VColor.Neutral.900}" />
    <SolidColorBrush x:Key="VBrush.TextSecondary" Color="{StaticResource VColor.Neutral.600}" />
    <SolidColorBrush x:Key="VBrush.TextMuted" Color="{StaticResource VColor.Neutral.500}" />
    <SolidColorBrush x:Key="VBrush.CodeBackground" Color="{StaticResource VColor.Neutral.50}" />

    <!-- Solid primary for buttons and selected surfaces; Accent is kept as
         the semantic alias consumed by older controls. -->
    <SolidColorBrush x:Key="VBrush.Primary" Color="{StaticResource VColor.Neutral.900}" />
    <SolidColorBrush x:Key="VBrush.PrimaryHover" Color="{StaticResource VColor.Neutral.800}" />
    <SolidColorBrush x:Key="VBrush.OnPrimary" Color="{StaticResource VColor.Neutral.50}" />
    <SolidColorBrush x:Key="VBrush.Accent" Color="{StaticResource VColor.Neutral.900}" />
    <SolidColorBrush x:Key="VBrush.AccentStrong" Color="{StaticResource VColor.Neutral.950}" />
    <SolidColorBrush x:Key="VBrush.AccentSubtle" Color="{StaticResource VColor.Neutral.100}" />
    <SolidColorBrush x:Key="VBrush.AccentSoft" Color="{StaticResource VColor.Neutral.50}" />
    <SolidColorBrush x:Key="VBrush.AccentBorder" Color="{StaticResource VColor.Neutral.300}" />
    <SolidColorBrush x:Key="VBrush.OnAccent" Color="{StaticResource VColor.Neutral.50}" />
    <SolidColorBrush x:Key="VBrush.FocusRing" Color="{StaticResource VColor.Neutral.400}" />
    <SolidColorBrush x:Key="VBrush.Scrim" Color="#66000000" />

    <SolidColorBrush x:Key="VBrush.Warning" Color="{StaticResource VColor.Warning}" />
    <SolidColorBrush x:Key="VBrush.Success" Color="{StaticResource VColor.Success}" />
    <SolidColorBrush x:Key="VBrush.Danger" Color="{StaticResource VColor.Danger}" />
    <SolidColorBrush x:Key="VBrush.Info" Color="{StaticResource VColor.Info}" />

    <SolidColorBrush x:Key="VBrush.IconPrimary" Color="{StaticResource VColor.Neutral.500}" />
    <SolidColorBrush x:Key="VBrush.HoverOverlay" Color="{StaticResource VColor.Neutral.900}" />
    <SolidColorBrush x:Key="VBrush.PressedOverlay" Color="{StaticResource VColor.Neutral.950}" />

    <SolidColorBrush x:Key="VBrush.Teal" Color="#0F766E" />
    <SolidColorBrush x:Key="VBrush.TealSubtle" Color="#F0FDFA" />
    <SolidColorBrush x:Key="VBrush.TealText" Color="#0F766E" />

    <!-- Status semantics (Kibo-style dot badges). -->
    <SolidColorBrush x:Key="VBrush.StatusOnline" Color="#16A34A" />
    <SolidColorBrush x:Key="VBrush.StatusOnlineSubtle" Color="#F0FDF4" />
    <SolidColorBrush x:Key="VBrush.StatusOffline" Color="#DC2626" />
    <SolidColorBrush x:Key="VBrush.StatusOfflineSubtle" Color="#FEF2F2" />
    <SolidColorBrush x:Key="VBrush.StatusAway" Color="#D97706" />
    <SolidColorBrush x:Key="VBrush.StatusAwaySubtle" Color="#FFFBEB" />
    <SolidColorBrush x:Key="VBrush.StatusBusy" Color="#DC2626" />
    <SolidColorBrush x:Key="VBrush.StatusBusySubtle" Color="#FEF2F2" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenance" Color="#2563EB" />
    <SolidColorBrush x:Key="VBrush.StatusMaintenanceSubtle" Color="#EFF6FF" />
    <SolidColorBrush x:Key="VBrush.StatusDegraded" Color="#D97706" />
    <SolidColorBrush x:Key="VBrush.StatusDegradedSubtle" Color="#FFFBEB" />
    <SolidColorBrush x:Key="VBrush.StatusNeutral" Color="#71717A" />
    <SolidColorBrush x:Key="VBrush.StatusNeutralSubtle" Color="#F4F4F5" />

    <!-- Popover / tooltip surfaces. -->
    <SolidColorBrush x:Key="VBrush.TooltipBackground" Color="{StaticResource VColor.Neutral.900}" />
    <SolidColorBrush x:Key="VBrush.TooltipForeground" Color="{StaticResource VColor.Neutral.50}" />
    <SolidColorBrush x:Key="VBrush.TooltipMuted" Color="{StaticResource VColor.Neutral.400}" />

    <!-- Segmented control. -->
    <SolidColorBrush x:Key="VBrush.SegmentTrack" Color="{StaticResource VColor.Neutral.100}" />
    <SolidColorBrush x:Key="VBrush.SegmentThumb" Color="{StaticResource VColor.Neutral.0}" />
    <SolidColorBrush x:Key="VBrush.SegmentThumbBorder" Color="{StaticResource VColor.Neutral.300}" />

    <!-- Slider. -->
    <SolidColorBrush x:Key="VBrush.SliderTrack" Color="{StaticResource VColor.Neutral.200}" />
    <SolidColorBrush x:Key="VBrush.SliderActive" Color="{StaticResource VColor.Neutral.900}" />
    <SolidColorBrush x:Key="VBrush.SliderThumb" Color="{StaticResource VColor.Neutral.900}" />
    <SolidColorBrush x:Key="VBrush.SliderThumbBorder" Color="{StaticResource VColor.Neutral.900}" />
    <SolidColorBrush x:Key="VBrush.SliderTick" Color="{StaticResource VColor.Neutral.400}" />
</ResourceDictionary>
